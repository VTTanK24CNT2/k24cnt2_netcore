@model VttLesson13.Models.Product
@{
    Layout = "~/Views/Shared/_LayoutCustom.cshtml";
    ViewData["Title"] = "Chi tiết: " + Model.Name;
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="/Products">Sản phẩm</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5">
    <div class="row g-0">
        <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-5 text-secondary" style="min-height: 350px;">
            <i class="bi @Model.ImageUrl" style="font-size: 8rem; color: #3b82f6;"></i>
        </div>
        <div class="col-md-7">
            <div class="card-body p-4 p-lg-5">
                <div class="mb-2">
                    <span class="badge bg-primary">@Model.Category</span>
                    @if (Model.IsFeatured)
                    {
                        <span class="badge bg-danger ms-1"><i class="bi bi-star-fill"></i> Nổi bật</span>
                    }
                </div>

                <h2 class="card-title fw-bold text-dark mb-3">@Model.Name</h2>

                <div class="display-6 fw-bold text-danger mb-4">
                    @Model.Price.ToString("N0") VNĐ
                </div>

                <p class="card-text text-secondary mb-4 fs-6">
                    @Model.Description
                </p>

                <div class="bg-light p-3 rounded-3 mb-4">
                    <ul class="list-unstyled mb-0 small text-muted">
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i> Bảo hành chính hãng 12 tháng</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i> Giao hàng miễn phí toàn quốc</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i> Đổi mới trong 30 ngày nếu có lỗi sản xuất</li>
                    </ul>
                </div>

                <div class="d-flex gap-3">
                    <button class="btn btn-primary btn-lg flex-grow-1 btn-add-to-cart" data-product-name="@Model.Name">
                        <i class="bi bi-cart-plus-fill me-2"></i> Thêm vào giỏ hàng
                    </button>
                    <a href="/Products" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
