@model List<VttLesson13.Models.Product>
@{
    // Chỉ định rõ Custom Layout theo bài học Slide 8 - 12
    Layout = "~/Views/Shared/_LayoutCustom.cshtml";
    ViewData["Title"] = "Danh sách sản phẩm";
    string currentCat = (string)(ViewData["CurrentCategory"] ?? "Tất cả");
}

<!-- Hộp giải thích cấu trúc bài học Session 07 -->
<div class="demo-section-box shadow-sm mb-4">
    <div class="d-flex align-items-center">
        <i class="bi bi-info-circle-fill text-primary fs-3 me-3"></i>
        <div>
            <h5 class="fw-bold mb-1">Minh họa Slide 8 - 12: Gán Custom Layout cho View</h5>
            <p class="mb-0 text-muted">
                Trang này được cấu hình <code>Layout = "~/Views/Shared/_LayoutCustom.cshtml";</code>.
                Toàn bộ nội dung hiển thị ở đây được nhúng vào vị trí <code>@@RenderBody()</code> của tệp <strong>_LayoutCustom.cshtml</strong>.
            </p>
        </div>
    </div>
</div>

<!-- Bộ lọc danh mục -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div class="btn-group mb-2 mb-md-0" role="group">
        <a href="/Products" class="btn @(currentCat == "Tất cả" ? "btn-primary" : "btn-outline-primary")">Tất cả</a>
        <a href="/Products?category=Laptop" class="btn @(currentCat == "Laptop" ? "btn-primary" : "btn-outline-primary")">Laptop</a>
        <a href="/Products?category=Điện thoại" class="btn @(currentCat == "Điện thoại" ? "btn-primary" : "btn-outline-primary")">Điện thoại</a>
        <a href="/Products?category=Phụ kiện" class="btn @(currentCat == "Phụ kiện" ? "btn-primary" : "btn-outline-primary")">Phụ kiện</a>
        <a href="/Products?category=Âm thanh" class="btn @(currentCat == "Âm thanh" ? "btn-primary" : "btn-outline-primary")">Âm thanh</a>
    </div>

    <div>
        <span class="badge bg-secondary p-2">Tổng cộng: @Model.Count sản phẩm</span>
    </div>
</div>

<!-- Danh sách sản phẩm (Grid Card) -->
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 product-card">
                <div class="card-img-wrapper position-relative">
                    <i class="bi @item.ImageUrl"></i>
                    @if (item.IsFeatured)
                    {
                        <span class="position-absolute top-0 end-0 badge bg-danger m-2">
                            <i class="bi bi-fire"></i> Hot
                        </span>
                    }
                </div>
                <div class="card-body d-flex flex-direction-column flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-light text-dark border">@item.Category</span>
                            <small class="text-muted">Mã: #@item.Id</small>
                        </div>
                        <h5 class="card-title fw-bold text-dark mt-2">@item.Name</h5>
                        <p class="card-text text-muted small">@item.Description</p>
                    </div>

                    <div class="pt-3 border-top mt-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Giá bán:</span>
                            <span class="product-price">@item.Price.ToString("N0") VNĐ</span>
                        </div>
                        <div class="d-grid gap-2 d-flex">
                            <a href="/Products/Details/@item.Id" class="btn btn-outline-secondary btn-sm flex-grow-1">
                                <i class="bi bi-eye"></i> Chi tiết
                            </a>
                            <button type="button" class="btn btn-primary btn-sm flex-grow-1 btn-add-to-cart" data-product-name="@item.Name">
                                <i class="bi bi-cart-plus"></i> Mua ngay
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Slide 6: Sử dụng @@section Scripts để chèn mã script riêng của View vào @@RenderSection("Scripts") -->
@section Scripts {
    <script>
        console.log("Trang danh sách sản phẩm Products/Index đã render xong script riêng.");
    </script>
}
