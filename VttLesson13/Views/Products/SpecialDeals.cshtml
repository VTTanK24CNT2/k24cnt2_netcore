@model List<VttLesson13.Models.Product>
@{
    Layout = "~/Views/Shared/_LayoutCustom.cshtml";
    ViewData["Title"] = "Khuyến mãi đặc biệt";
}

@section Banner {
    <div class="p-5 text-white bg-danger mb-4 shadow" style="background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);">
        <div class="container text-center">
            <h1 class="display-5 fw-bold"><i class="bi bi-gift-fill me-2"></i> SIÊU SALE KHỦNG TRONG TUẦN</h1>
            <p class="lead">Trang này được nhúng qua <code>@@section Banner</code> tùy biến trong <strong>_LayoutCustom.cshtml</strong></p>
        </div>
    </div>
}

<div class="alert alert-warning d-flex align-items-center mb-4">
    <i class="bi bi-clock-history fs-3 me-3 text-warning"></i>
    <div>
        <strong>Chương trình ưu đãi có hạn:</strong> Giảm giá đặc biệt cho các dòng máy và phụ kiện công nghệ hàng đầu.
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 product-card border-danger">
                <div class="card-img-wrapper position-relative bg-danger bg-opacity-10">
                    <i class="bi @item.ImageUrl text-danger"></i>
                    <span class="position-absolute top-0 start-0 badge bg-danger m-2">Giảm 20%</span>
                </div>
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <span class="badge bg-danger">Khuyến mãi HOT</span>
                        <h5 class="card-title fw-bold text-dark mt-2">@item.Name</h5>
                        <p class="card-text text-muted small">@item.Description</p>
                    </div>
                    <div class="pt-3 border-top mt-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-decoration-line-through text-muted small">@((item.Price * 1.25m).ToString("N0")) VNĐ</span>
                            <span class="product-price">@item.Price.ToString("N0") VNĐ</span>
                        </div>
                        <a href="/Products/Details/@item.Id" class="btn btn-danger w-100 btn-sm">Xem ngay</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
