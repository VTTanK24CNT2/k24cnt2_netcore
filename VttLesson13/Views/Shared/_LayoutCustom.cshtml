<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cửa hàng Trực tuyến (Custom Layout)</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- CSS tùy chỉnh của Session 07 -->
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />

    <!-- Section Styles riêng của từng trang nếu có -->
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="custom-theme">
    <!-- Header chung của Custom Layout -->
    <header class="custom-header sticky-top">
        <div class="container py-2">
            <div class="d-flex flex-wrap align-items-center justify-content-between">
                <a href="/Products" class="custom-brand d-flex align-items-center text-decoration-none">
                    <i class="bi bi-bag-check-fill me-2 text-warning"></i>
                    <span>DEV-STORE (CUSTOM LAYOUT)</span>
                </a>

                <ul class="nav col-12 col-lg-auto my-2 justify-content-center my-md-0 text-small">
                    <li>
                        <a href="/" class="nav-link custom-nav-link">
                            <i class="bi bi-house-door d-block mx-auto mb-1 text-center" style="font-size: 1.2rem;"></i>
                            Trang chủ mặc định
                        </a>
                    </li>
                    <li>
                        <a href="/Products" class="nav-link custom-nav-link active">
                            <i class="bi bi-grid d-block mx-auto mb-1 text-center" style="font-size: 1.2rem;"></i>
                            Tất cả sản phẩm
                        </a>
                    </li>
                    <li>
                        <a href="/Products/SpecialDeals" class="nav-link custom-nav-link">
                            <i class="bi bi-fire d-block mx-auto mb-1 text-center" style="font-size: 1.2rem;"></i>
                            Khuyến mãi hot
                        </a>
                    </li>
                    <li>
                        <a href="/Admin/Dashboard" class="nav-link custom-nav-link">
                            <i class="bi bi-speedometer2 d-block mx-auto mb-1 text-center" style="font-size: 1.2rem;"></i>
                            Khu vực Quản trị (Area Admin)
                        </a>
                    </li>
                </ul>

                <div class="text-end">
                    <button type="button" id="btnJsDemo" class="btn btn-warning btn-sm fw-bold">
                        <i class="bi bi-lightning-charge-fill"></i> Test JS Event
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Section 1 (S1): Banner hoặc Breadcrumb riêng nếu trang con cung cấp -->
    @if (IsSectionDefined("Banner"))
    {
        @RenderSection("Banner", required: false)
    }
    else
    {
        <div class="custom-banner text-center">
            <div class="container">
                <h1 class="display-6 fw-bold">Chào mừng bạn đến với Cửa hàng Devmaster</h1>
                <p class="lead mb-0">Minh họa bố cục Custom Layout với ASP.NET Core MVC (Session 07)</p>
            </div>
        </div>
    }

    <!-- Nội dung chính: Nơi các View con được chèn vào thông qua @@RenderBody() -->
    <main class="container my-3 flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer chung của Custom Layout -->
    <footer class="custom-footer">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <h5 class="text-white mb-1"><i class="bi bi-code-slash text-primary"></i> Session 07 - Layout trong ASP.NET Core</h5>
                    <p class="small text-muted mb-0">Học phần Lập trình Web ASP.NET Core MVC - Devmaster Academy</p>
                </div>
                <div class="col-md-6 text-center text-md-end mt-3 mt-md-0">
                    <a href="/" class="text-secondary text-decoration-none me-3"><i class="bi bi-arrow-left"></i> Về Layout mặc định</a>
                    <a href="/Admin/Dashboard" class="btn btn-outline-light btn-sm"><i class="bi bi-shield-lock"></i> Vào trang Admin</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Thư viện Javascript dùng chung -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- File JavaScript tùy chỉnh (Slide 18 - 21) -->
    <script src="~/js/custom.js" asp-append-version="true"></script>

    <!-- Section Scripts riêng của từng View (Slide 6) -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
