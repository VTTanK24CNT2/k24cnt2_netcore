@{
    ViewData["Title"] = "Trang chủ - EF Core Database First";
}

<div class="container py-5">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
        <div class="container-fluid py-3 text-center">
            <h1 class="display-5 fw-bold text-primary mb-3">
                <i class="bi bi-database-check me-2"></i>Bài Tập EF Core Database-First
            </h1>
            <p class="col-md-8 fs-5 text-muted mx-auto mb-4">
                Hệ thống quản lý dữ liệu sử dụng ASP.NET Core 8.0 MVC kết nối với SQL Server thông qua Entity Framework Core Database-First.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="VttMembers" asp-action="Index" class="btn btn-primary btn-lg px-4 shadow">
                    <i class="bi bi-people-fill me-2"></i>Vào Quản Lý Thành Viên (CRUD)
                </a>
                <a asp-controller="VttMembers" asp-action="Create" class="btn btn-outline-success btn-lg px-4 shadow-sm">
                    <i class="bi bi-person-plus-fill me-2"></i>Thêm Mới Thành Viên
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-3">
                <div class="card-body">
                    <i class="bi bi-diagram-3-fill fs-1 text-primary mb-2"></i>
                    <h5 class="fw-bold">Database-First</h5>
                    <p class="text-muted small">Cấu trúc bảng <code>VttMember</code> và <code>VttLesson10EfdbContext</code> được sinh trực tiếp từ SQL Server.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-3">
                <div class="card-body">
                    <i class="bi bi-lightning-charge-fill fs-1 text-warning mb-2"></i>
                    <h5 class="fw-bold">Tối ưu hiệu năng LINQ</h5>
                    <p class="text-muted small">Áp dụng <code>AsNoTracking()</code> cho các truy vấn Read-only theo chuẩn kiến trúc bài giảng Session 06.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-3">
                <div class="card-body">
                    <i class="bi bi-shield-lock-fill fs-1 text-success mb-2"></i>
                    <h5 class="fw-bold">Xác thực & Bảo mật</h5>
                    <p class="text-muted small">Trang bị kiểm tra trùng lặp tài khoản, chống CSRF Token và Data Annotations đầy đủ.</p>
                </div>
            </div>
        </div>
    </div>
</div>
