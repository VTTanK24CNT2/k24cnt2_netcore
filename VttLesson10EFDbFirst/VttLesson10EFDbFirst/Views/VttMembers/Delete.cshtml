@model VttLesson10EFDbFirst.Models.VttMember

@{
    ViewData["Title"] = "Xác nhận Xóa Thành viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-danger border-opacity-50">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác Nhận Xóa Thành Viên
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-circle-fill fs-4 me-3"></i>
                        <div>
                            Bạn có chắc chắn muốn xóa thành viên này khỏi hệ thống không? Hành động này không thể hoàn tác!
                        </div>
                    </div>

                    <ul class="list-group list-group-flush mb-4 border rounded">
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <span class="text-muted">Mã ID:</span>
                            <span class="fw-bold">#@Model.Id</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <span class="text-muted">Họ và tên:</span>
                            <span class="fw-semibold">@Model.VttFullName</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <span class="text-muted">Tên đăng nhập:</span>
                            <span>@Model.VttUserName</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <span class="text-muted">Email:</span>
                            <span>@(Model.VttEmail ?? "Chưa có")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                            <span class="text-muted">Số điện thoại:</span>
                            <span>@(Model.VttPhone ?? "Chưa có")</span>
                        </li>
                    </ul>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Hủy & Quay lại
                            </a>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash-fill me-1"></i> Xác nhận Xóa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
