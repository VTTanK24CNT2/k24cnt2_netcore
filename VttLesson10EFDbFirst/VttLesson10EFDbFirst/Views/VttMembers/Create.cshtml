@model VttLesson10EFDbFirst.Models.VttMember

@{
    ViewData["Title"] = "Thêm mới Thành viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-person-plus-fill me-2"></i>Thêm Mới Thành Viên
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-3">
                            <!-- UserName -->
                            <div class="col-md-6">
                                <label asp-for="VttUserName" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input asp-for="VttUserName" class="form-control" placeholder="Nhập username..." />
                                </div>
                                <span asp-validation-for="VttUserName" class="text-danger small"></span>
                            </div>

                            <!-- Password -->
                            <div class="col-md-6">
                                <label asp-for="VttPassword" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-key"></i></span>
                                    <input asp-for="VttPassword" class="form-control" type="password" placeholder="Nhập mật khẩu..." />
                                </div>
                                <span asp-validation-for="VttPassword" class="text-danger small"></span>
                            </div>

                            <!-- FullName -->
                            <div class="col-12">
                                <label asp-for="VttFullName" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-card-heading"></i></span>
                                    <input asp-for="VttFullName" class="form-control" placeholder="Nhập họ và tên..." />
                                </div>
                                <span asp-validation-for="VttFullName" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label asp-for="VttEmail" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="VttEmail" class="form-control" type="email" placeholder="example@email.com" />
                                </div>
                                <span asp-validation-for="VttEmail" class="text-danger small"></span>
                            </div>

                            <!-- Phone -->
                            <div class="col-md-6">
                                <label asp-for="VttPhone" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="VttPhone" class="form-control" placeholder="09xxxxxxxx" />
                                </div>
                                <span asp-validation-for="VttPhone" class="text-danger small"></span>
                            </div>

                            <!-- Status -->
                            <div class="col-12">
                                <label asp-for="VttStatus" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-shield-check"></i></span>
                                    <select asp-for="VttStatus" class="form-select">
                                        <option value="true">Hoạt động (Active)</option>
                                        <option value="false">Tạm khóa (Inactive)</option>
                                    </select>
                                </div>
                                <span asp-validation-for="VttStatus" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-lg me-1"></i> Lưu thông tin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
