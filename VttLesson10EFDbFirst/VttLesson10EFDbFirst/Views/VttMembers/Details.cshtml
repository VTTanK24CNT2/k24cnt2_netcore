@model VttLesson10EFDbFirst.Models.VttMember

@{
    ViewData["Title"] = "Chi tiết Thành viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-info bg-opacity-25 border-info py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="bi bi-person-badge me-2"></i>Chi Tiết Thành Viên
                    </h5>
                    <span class="badge bg-secondary">ID: #@Model.Id</span>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="avatar bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 70px; height: 70px; font-size: 28px;">
                            @(string.IsNullOrEmpty(Model.VttFullName) ? "U" : Model.VttFullName.Substring(0, 1).ToUpper())
                        </div>
                        <h4 class="fw-bold mb-0">@Model.VttFullName</h4>
                        <span class="badge bg-light text-dark border">@@@Model.VttUserName</span>
                    </div>

                    <ul class="list-group list-group-flush mb-4 border rounded">
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="bi bi-person-fill me-2"></i>@Html.DisplayNameFor(model => model.VttUserName):</span>
                            <span class="fw-semibold">@Model.VttUserName</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="bi bi-envelope-fill me-2"></i>@Html.DisplayNameFor(model => model.VttEmail):</span>
                            <span>@(Model.VttEmail ?? "Chưa thiết lập")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="bi bi-telephone-fill me-2"></i>@Html.DisplayNameFor(model => model.VttPhone):</span>
                            <span>@(Model.VttPhone ?? "Chưa thiết lập")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <span class="text-muted"><i class="bi bi-shield-check me-2"></i>@Html.DisplayNameFor(model => model.VttStatus):</span>
                            <span>
                                @if (Model.VttStatus == true)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đang hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-slash-circle me-1"></i>Đã tạm khóa</span>
                                }
                            </span>
                        </li>
                    </ul>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                                <i class="bi bi-trash me-1"></i> Xóa
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
