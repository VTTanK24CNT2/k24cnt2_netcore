@{
    ViewData["Title"] = "Tổng quan Quản trị";
    var recentProducts = ViewBag.RecentProducts as List<VttLesson14CoreA7.Models.Product> ?? new List<VttLesson14CoreA7.Models.Product>();
    var recentBanners = ViewBag.RecentBanners as List<VttLesson14CoreA7.Models.BannerBlog> ?? new List<VttLesson14CoreA7.Models.BannerBlog>();
}

<!-- Quick Stats Row (AdminLTE Style Small Boxes) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="small-box bg-gradient-primary">
            <div class="inner">
                <h3>@ViewBag.CategoryCount</h3>
                <p>Danh mục (Category)</p>
            </div>
            <div class="icon">
                <i class="bi bi-tags"></i>
            </div>
            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="small-box-footer">
                Xem chi tiết <i class="bi bi-arrow-right-circle ms-1"></i>
            </a>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="small-box bg-gradient-success">
            <div class="inner">
                <h3>@ViewBag.ProductCount</h3>
                <p>Sản phẩm (Product)</p>
            </div>
            <div class="icon">
                <i class="bi bi-box-seam"></i>
            </div>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="small-box-footer">
                Xem chi tiết <i class="bi bi-arrow-right-circle ms-1"></i>
            </a>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="small-box bg-gradient-warning">
            <div class="inner">
                <h3>@ViewBag.BannerCount</h3>
                <p>Banner / Blog</p>
            </div>
            <div class="icon">
                <i class="bi bi-newspaper"></i>
            </div>
            <a asp-area="Admin" asp-controller="BannerBlog" asp-action="Index" class="small-box-footer">
                Xem chi tiết <i class="bi bi-arrow-right-circle ms-1"></i>
            </a>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="small-box bg-gradient-purple">
            <div class="inner">
                <h3 style="font-size: 1.6rem;">@(((double)ViewBag.TotalProductValue).ToString("N0")) đ</h3>
                <p>Tổng giá trị kho hàng</p>
            </div>
            <div class="icon">
                <i class="bi bi-cash-stack"></i>
            </div>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="small-box-footer">
                Quản lý kho <i class="bi bi-arrow-right-circle ms-1"></i>
            </a>
        </div>
    </div>
</div>

<!-- Quick Action Buttons -->
<div class="admin-card mb-4 border-0 shadow-sm">
    <div class="admin-card-body py-3 bg-white rounded-3 d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <div class="fw-semibold text-secondary">
            <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Thao tác nhanh:
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Thêm Danh mục
            </a>
            <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn btn-sm btn-success">
                <i class="bi bi-plus-circle me-1"></i> Thêm Sản phẩm
            </a>
            <a asp-area="Admin" asp-controller="BannerBlog" asp-action="Create" class="btn btn-sm btn-warning text-dark fw-semibold">
                <i class="bi bi-plus-circle me-1"></i> Tạo Banner / Blog
            </a>
        </div>
    </div>
</div>

<!-- Recent Data Tables Row -->
<div class="row g-4">
    <!-- Recent Products Table -->
    <div class="col-12 col-lg-7">
        <div class="admin-card h-100 shadow-sm">
            <div class="admin-card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold m-0 text-primary">
                    <i class="bi bi-box-seam me-2"></i>Sản phẩm mới cập nhật
                </h5>
                <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
            </div>
            <div class="admin-card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th>Danh mục</th>
                                <th class="text-end">Giá bán</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!recentProducts.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">Chưa có sản phẩm nào.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in recentProducts)
                                {
                                    <tr>
                                        <td style="width: 50px;">
                                            @if (!string.IsNullOrEmpty(item.Image))
                                            {
                                                <img src="@item.Image" alt="@item.Name" class="rounded border" style="width: 42px; height: 42px; object-fit: cover;" onerror="this.onerror=null;this.src='https://placehold.co/42x42?text=SP';" />
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded border text-muted d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                                    <i class="bi bi-image"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <a asp-area="Admin" asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" class="fw-semibold text-decoration-none text-dark">
                                                @item.Name
                                            </a>
                                        </td>
                                        <td>
                                            <span class="badge bg-info-subtle text-info border">
                                                @(item.Category?.Name ?? "N/A")
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold text-danger">
                                            @item.Price.ToString("N0") đ
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Banners / Blogs -->
    <div class="col-12 col-lg-5">
        <div class="admin-card h-100 shadow-sm">
            <div class="admin-card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold m-0 text-warning text-dark">
                    <i class="bi bi-newspaper me-2"></i>Banner &amp; Tin tức mới
                </h5>
                <a asp-area="Admin" asp-controller="BannerBlog" asp-action="Index" class="btn btn-sm btn-outline-secondary">Xem tất cả</a>
            </div>
            <div class="admin-card-body p-3">
                @if (!recentBanners.Any())
                {
                    <div class="text-center py-4 text-muted">Chưa có bài viết hoặc banner nào.</div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var b in recentBanners)
                        {
                            <div class="list-group-item px-0 py-2 border-bottom">
                                <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                                    <span class="badge @(b.Type == "Banner" ? "bg-warning text-dark" : "bg-info text-white")">
                                        @b.Type
                                    </span>
                                    <small class="text-muted">@b.CreatedDate.ToString("dd/MM/yyyy")</small>
                                </div>
                                <h6 class="mb-1 text-truncate fw-semibold">
                                    <a asp-area="Admin" asp-controller="BannerBlog" asp-action="Details" asp-route-id="@b.Id" class="text-decoration-none text-dark">
                                        @b.Title
                                    </a>
                                </h6>
                                <p class="mb-0 text-muted small text-truncate">@b.Description</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
