@model VttLesson14CoreA7.Models.BannerBlog

@{
    ViewData["Title"] = "Chi tiết " + Model.Type + ": " + Model.Title;
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header bg-white border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center w-100">
                    <h5 class="card-title fw-bold text-dark m-0">
                        <i class="bi bi-newspaper me-2 text-warning"></i>Chi tiết @Model.Type #@Model.Id
                    </h5>
                    <span class="badge @(Model.Type == "Banner" ? "bg-warning text-dark" : "bg-info text-white") fs-6">
                        @Model.Type
                    </span>
                </div>
            </div>
            <div class="admin-card-body p-4">
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <div class="mb-4 text-center">
                        <img src="@Model.Image" alt="@Model.Title" class="img-fluid rounded border shadow-sm" style="max-height: 280px; width: 100%; object-fit: cover;" onerror="this.onerror=null;this.src='https://placehold.co/600x250?text=Banner';" />
                    </div>
                }

                <h3 class="fw-bold text-dark mb-3">@Model.Title</h3>

                <div class="d-flex gap-3 text-muted small mb-4 pb-3 border-bottom">
                    <div>
                        <i class="bi bi-calendar3 me-1"></i> Ngày tạo: <strong>@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                    <div>
                        <i class="bi bi-toggle-on me-1"></i> Trạng thái:
                        @if (Model.IsActive)
                        {
                            <span class="text-success fw-bold">Đang hiển thị</span>
                        }
                        else
                        {
                            <span class="text-secondary fw-bold">Đang ẩn</span>
                        }
                    </div>
                </div>

                <div class="lead fs-6 text-secondary mb-4" style="line-height: 1.8;">
                    @Model.Description
                </div>

                <div class="pt-3 border-top d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-dark fw-semibold">
                        <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
