@model VttLesson14CoreA7.Models.Category

@{
    ViewData["Title"] = "Thêm mới Danh mục (Category)";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="admin-card">
            <div class="admin-card-header bg-white border-bottom py-3">
                <h5 class="card-title fw-bold text-primary m-0">
                    <i class="bi bi-folder-plus me-2"></i>Thêm Danh mục Mới
                </h5>
            </div>
            <div class="admin-card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: Điện thoại, Laptop, Phụ kiện..." autofocus />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                        <div class="form-text">Tên danh mục không được để trống và không được trùng lặp.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="1">1 - Hiển thị (Mặc định)</option>
                            <option value="0">0 - Ẩn</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CreatedDate" class="form-label fw-semibold"></label>
                        <input asp-for="CreatedDate" class="form-control" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                        <span asp-validation-for="CreatedDate" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Lưu Danh mục
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
