@model IEnumerable<VttLesson14CoreA7.Models.Category>

@{
    ViewData["Title"] = "Danh sách Danh mục (Category)";
}

<div class="admin-card">
    <div class="admin-card-header bg-white py-3">
        <div class="row align-items-center g-2">
            <div class="col-md-6">
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Thêm mới Danh mục
                </a>
            </div>
            <div class="col-md-6">
                <form method="get" class="d-flex gap-2">
                    <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Tìm theo tên danh mục..." />
                    <select name="status" class="form-select" style="max-width: 140px;">
                        <option value="">Tất cả TT</option>
                        <option value="1" selected="@(ViewBag.Status?.ToString() == "1")">Hiển thị</option>
                        <option value="0" selected="@(ViewBag.Status?.ToString() == "0")">Ẩn</option>
                    </select>
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-search"></i>
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.SearchString) || ViewBag.Status != null)
                    {
                        <a asp-action="Index" class="btn btn-outline-danger" title="Xóa bộ lọc">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </form>
            </div>
        </div>
    </div>

    <div class="admin-card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">Mã</th>
                        <th>Tên danh mục</th>
                        <th>Trạng thái</th>
                        <th>Số lượng SP</th>
                        <th>Ngày tạo</th>
                        <th class="text-end" style="min-width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Không tìm thấy danh mục nào phù hợp!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-secondary">#@item.Id</td>
                                <td>
                                    <span class="fw-semibold text-dark fs-6">@item.Name</span>
                                </td>
                                <td>
                                    @if (item.Status == 1)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i> Hiển thị
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-eye-slash me-1"></i> Ẩn
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-primary rounded-pill px-2">
                                        @(item.Products?.Count ?? 0) sản phẩm
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    @item.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Chỉnh sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
