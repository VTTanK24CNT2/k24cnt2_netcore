@model VttLesson14CoreA7.Models.Product

@{
    ViewData["Title"] = "Xác nhận xóa Sản phẩm";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="admin-card border-danger">
            <div class="admin-card-header bg-danger text-white py-3">
                <h5 class="card-title fw-bold m-0">
                    <i class="bi bi-trash3-fill me-2"></i>Xác nhận xóa Sản phẩm
                </h5>
            </div>
            <div class="admin-card-body p-4">
                <p class="text-danger fw-semibold">Bạn có chắc chắn muốn xóa sản phẩm này khỏi hệ thống không?</p>

                <div class="bg-light p-3 rounded mb-4 d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="@Model.Image" alt="@Model.Name" class="rounded border" style="width: 70px; height: 70px; object-fit: cover;" onerror="this.onerror=null;this.src='https://placehold.co/70x70?text=SP';" />
                    }
                    <div>
                        <div class="fw-bold text-dark fs-5">@Model.Name</div>
                        <div class="text-danger fw-bold">@Model.Price.ToString("N0") đ</div>
                        <small class="text-muted">Danh mục: @(Model.Category?.Name ?? "Chưa phân loại")</small>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i> Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash-fill me-1"></i> Xóa sản phẩm
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
