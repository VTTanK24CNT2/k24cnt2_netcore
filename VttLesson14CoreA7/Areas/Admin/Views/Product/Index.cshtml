@model IEnumerable<VttLesson14CoreA7.Models.Product>

@{
    ViewData["Title"] = "Danh sách Sản phẩm (Product)";
}

<div class="admin-card">
    <div class="admin-card-header bg-white py-3">
        <div class="row align-items-center g-2">
            <div class="col-md-5">
                <a asp-action="Create" class="btn btn-success">
                    <i class="bi bi-plus-circle me-1"></i> Thêm mới Sản phẩm
                </a>
            </div>
            <div class="col-md-7">
                <form method="get" class="d-flex gap-2">
                    <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Tìm theo tên sản phẩm..." />
                    <select name="categoryId" asp-items="ViewBag.Categories" class="form-select" style="max-width: 180px;">
                        <option value="">Tất cả danh mục</option>
                    </select>
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-search"></i>
                    </button>
                    @if (!string.IsNullOrEmpty(ViewBag.SearchString) || ViewBag.CategoryId != null)
                    {
                        <a asp-action="Index" class="btn btn-outline-danger" title="Xóa bộ lọc">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </form>
            </div>
        </div>
    </div>

    <div class="admin-card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">Mã</th>
                        <th style="width: 80px;">Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th class="text-end">Giá bán</th>
                        <th class="text-end" style="min-width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Không tìm thấy sản phẩm nào!
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-secondary">#@item.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="@item.Image" alt="@item.Name" class="rounded border shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.onerror=null;this.src='https://placehold.co/50x50?text=SP';" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded border text-muted d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                            <i class="bi bi-image text-muted fs-5"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark fs-6">@item.Name</div>
                                    <small class="text-muted">Mã danh mục: @item.CategoryId</small>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info border px-2 py-1">
                                        <i class="bi bi-tag me-1"></i>@(item.Category?.Name ?? "Chưa phân loại")
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-danger fs-6">
                                    @item.Price.ToString("N0") đ
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Chỉnh sửa">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
