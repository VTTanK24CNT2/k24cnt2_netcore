
@model VttLesson08Models.Models.VttMember

@{
    ViewData["Title"] = "Thông tin chi tiết thành viên";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>VttMember</h4>
    <hr />

    <dl class="row">
