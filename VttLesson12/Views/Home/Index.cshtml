@model IEnumerable<VttLesson12.Models.Product>

@{
    ViewData["Title"] = "Trang chủ - Cửa hàng sách & giáo trình";
    var banners = ViewBag.Banners as List<VttLesson12.Models.Banner>;
}

<!-- Hero / Banner Section -->
@if (banners != null && banners.Any())
{
    <div id="homeBannerCarousel" class="carousel slide mb-5 shadow rounded overflow-hidden" data-bs-ride="carousel">
        <div class="carousel-inner">
            @{ var isFirst = true; }
            @foreach (var banner in banners)
            {
                <div class="carousel-item @(isFirst ? "active" : "")">
                    <img src="@banner.Image" class="d-block w-100" style="max-height: 400px; object-fit: cover;" alt="@banner.Name" />
                    <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 p-3 rounded">
                        <h4>@banner.Name</h4>
                        <p class="mb-0">@banner.Description</p>
                    </div>
                </div>
                isFirst = false;
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
}
else
{
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border text-center">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold text-primary">CHÀO MỪNG ĐẾN VỚI VTT BOOK STORE</h1>
            <p class="col-md-8 mx-auto fs-5 text-muted">
                Hệ thống quản lý và giới thiệu sách, giáo trình & tài liệu học tập ASP.NET Core MVC với Entity Framework Core.
            </p>
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a asp-action="Product" class="btn btn-primary btn-lg px-4">
                    <i class="bi bi-grid-3x3-gap"></i> Xem sản phẩm dạng lưới (Bài 2)
                </a>
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                    <i class="bi bi-gear"></i> Trang quản lý CRUD (Bài 1)
                </a>
            </div>
        </div>
    </div>
}

<!-- Featured Products Section -->
<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark border-start border-4 border-primary ps-3 mb-0">SẢN PHẨM MỚI NHẤT</h3>
        <a asp-action="Product" class="btn btn-link text-decoration-none">
            Xem tất cả <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="p-3 text-center bg-light" style="height: 200px; display: flex; align-items: center; justify-content: center;">
                            @if (!string.IsNullOrEmpty(item.VttImages))
                            {
                                <img src="@item.VttImages" alt="@item.VttName" class="img-fluid" style="max-height: 180px; object-fit: contain;" />
                            }
                            else
                            {
                                <span class="text-muted">Chưa có ảnh</span>
                            }
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title fw-bold text-truncate" title="@item.VttName">@item.VttName</h6>
                            <div class="mt-auto">
                                <div class="mb-2">
                                    @if (item.VttSalePrice.HasValue)
                                    {
                                        <span class="text-danger fw-bold fs-5">@string.Format("{0:N0} đ", item.VttSalePrice.Value)</span>
                                        <small class="text-muted text-decoration-line-through ms-1">@string.Format("{0:N0} đ", item.VttPrice)</small>
                                    }
                                    else
                                    {
                                        <span class="text-primary fw-bold fs-5">@string.Format("{0:N0} đ", item.VttPrice)</span>
                                    }
                                </div>
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.VttId" class="btn btn-sm btn-outline-primary w-100">
                                    Chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
