@model IEnumerable<VttLesson12.Models.Product>

@{
    ViewData["Title"] = "Cửa hàng sản phẩm - Dạng lưới (Grid)";
}

<div class="container my-4">
    <!-- Header -->
    <div class="text-center mb-5">
        <h2 class="display-6 fw-bold text-primary">DANH SÁCH SẢN PHẨM</h2>
        <p class="text-muted">Bộ sưu tập sách & tài liệu học tập chọn lọc</p>
        <hr class="w-25 mx-auto text-primary" style="height: 3px;" />
    </div>

    <!-- Product Grid -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 transition-hover">
                        <!-- Badge Sale -->
                        @if (item.VttSalePrice.HasValue && item.VttSalePrice < item.VttPrice)
                        {
                            <span class="position-absolute top-0 start-0 badge bg-danger m-2 px-2 py-1">
                                Giảm @string.Format("{0:0}%", ((item.VttPrice - item.VttSalePrice.Value) / item.VttPrice) * 100)
                            </span>
                        }

                        <!-- Ảnh sản phẩm -->
                        <div class="p-3 text-center bg-light" style="height: 220px; display: flex; align-items: center; justify-content: center;">
                            @if (!string.IsNullOrEmpty(item.VttImages))
                            {
                                <img src="@item.VttImages" alt="@item.VttName" class="img-fluid" style="max-height: 190px; object-fit: contain;" />
                            }
                            else
                            {
                                <span class="text-muted">Chưa có ảnh</span>
                            }
                        </div>

                        <!-- Nội dung -->
                        <div class="card-body d-flex flex-column">
                            <small class="text-muted text-uppercase mb-1">@(item.VttCategoryId ?? "Danh mục chung")</small>
                            <h6 class="card-title fw-bold text-truncate" title="@item.VttName">
                                @item.VttName
                            </h6>
                            <p class="card-text text-muted small text-truncate-2 mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 38px;">
                                @(string.IsNullOrEmpty(item.VttDescription) ? "Sản phẩm chất lượng cao." : item.VttDescription)
                            </p>

                            <div class="mt-auto">
                                <div class="d-flex align-items-baseline gap-2 mb-2">
                                    @if (item.VttSalePrice.HasValue)
                                    {
                                        <span class="text-danger fw-bold fs-5">@string.Format("{0:N0} đ", item.VttSalePrice.Value)</span>
                                        <small class="text-muted text-decoration-line-through">@string.Format("{0:N0} đ", item.VttPrice)</small>
                                    }
                                    else
                                    {
                                        <span class="text-primary fw-bold fs-5">@string.Format("{0:N0} đ", item.VttPrice)</span>
                                    }
                                </div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle small mb-2">
                                    @item.VttStatus
                                </span>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="card-footer bg-white border-0 pt-0 pb-3">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.VttId" class="btn btn-outline-primary w-100">
                                <i class="bi bi-eye"></i> Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 text-muted">
                <h4>Chưa có sản phẩm nào được hiển thị</h4>
            </div>
        }
    </div>
</div>
