@model VttLesson12.Models.Product

@{
    ViewData["Title"] = "Thêm mới sản phẩm";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Thêm mới sản phẩm (Upload ảnh)</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="VttId" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <input asp-for="VttId" class="form-control" placeholder="VD: SP001" />
                                <span asp-validation-for="VttId" class="text-danger"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="VttName" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <input asp-for="VttName" class="form-control" placeholder="Nhập tên sản phẩm..." />
                                <span asp-validation-for="VttName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="VttPrice" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <div class="input-group">
                                    <input asp-for="VttPrice" class="form-control" type="number" step="1000" min="0" placeholder="0" />
                                    <span class="input-group-text">VNĐ</span>
                                </div>
                                <span asp-validation-for="VttPrice" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="VttSalePrice" class="form-label fw-bold"></label>
                                <div class="input-group">
                                    <input asp-for="VttSalePrice" class="form-control" type="number" step="1000" min="0" placeholder="0" />
                                    <span class="input-group-text">VNĐ</span>
                                </div>
                                <span asp-validation-for="VttSalePrice" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="VttCategoryId" class="form-label fw-bold"></label>
                                <input asp-for="VttCategoryId" class="form-control" placeholder="VD: CAT01" />
                                <span asp-validation-for="VttCategoryId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="VttStatus" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <select asp-for="VttStatus" class="form-select">
                                    <option value="Còn hàng">Còn hàng</option>
                                    <option value="Hết hàng">Hết hàng</option>
                                    <option value="Tạm ngưng">Tạm ngưng</option>
                                </select>
                                <span asp-validation-for="VttStatus" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageUpload" class="form-label fw-bold"></label>
                            <input asp-for="ImageUpload" class="form-control" type="file" accept="image/*" id="imageInput" onchange="previewImage(event)" />
                            <span asp-validation-for="ImageUpload" class="text-danger"></span>
                            <div class="mt-2 text-center">
                                <img id="imagePreview" src="#" alt="Xem trước hình ảnh" class="img-thumbnail d-none" style="max-height: 180px; object-fit: contain;" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="VttDescription" class="form-label fw-bold"></label>
                            <textarea asp-for="VttDescription" class="form-control" rows="3" placeholder="Nhập mô tả chi tiết sản phẩm..."></textarea>
                            <span asp-validation-for="VttDescription" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại danh sách
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-lg"></i> Thêm sản phẩm
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function() {
                var output = document.getElementById('imagePreview');
                output.src = reader.result;
                output.classList.remove('d-none');
            };
            if (event.target.files[0]) {
                reader.readAsDataURL(event.target.files[0]);
            }
        }
    </script>
}
