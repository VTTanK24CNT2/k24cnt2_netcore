@model BtLabLesson09.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-info text-dark py-3">
                    <h4 class="mb-0"><i class="bi bi-info-circle"></i> Chi tiết sản phẩm #@Model.Id</h4>
                </div>
                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-5 text-center mb-3 mb-md-0">
                            <img src="@Model.Image" alt="@Model.Name" class="img-fluid rounded border shadow-sm" style="max-height: 250px; object-fit: cover;" onerror="this.src='https://placehold.co/300x250?text=No+Image'" />
                            <div class="small text-muted mt-2">Đường dẫn: <code>@Model.Image</code></div>
                        </div>
                        <div class="col-md-7">
                            <h3 class="fw-bold mb-2">@Model.Name</h3>
                            <p class="mb-2">
                                <span class="badge bg-primary">Danh mục: @ViewBag.CategoryName</span>
                            </p>
                            <div class="mb-3">
                                <div class="text-muted text-decoration-line-through">Giá niêm yết: @Model.Price.ToString("N0") đ</div>
                                <h4 class="text-danger fw-bold">Giá khuyến mãi: @Model.SalePrice.ToString("N0") đ</h4>
                                @{
                                    float discount = ((Model.Price - Model.SalePrice) / Model.Price) * 100;
                                }
                                <span class="badge bg-danger">Tiết kiệm: @discount.ToString("0.1")%</span>
                            </div>

                            <hr />
                            <h6 class="fw-bold text-secondary">Mô tả sản phẩm:</h6>
                            <p class="text-dark bg-light p-3 rounded border">@Model.Description</p>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lại danh sách
                        </a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                                <i class="bi bi-pencil"></i> Chỉnh sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                                <i class="bi bi-trash"></i> Xóa
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
