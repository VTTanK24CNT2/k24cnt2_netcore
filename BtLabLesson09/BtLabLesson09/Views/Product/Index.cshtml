@model IEnumerable<BtLabLesson09.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
    var categoryDict = ViewBag.Categories as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2><i class="bi bi-box-seam-fill"></i> Quản lý sản phẩm (Product CRUD)</h2>
            <p class="text-muted mb-0">Áp dụng Data Annotation và Custom Validation nâng cao</p>
        </div>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm mới sản phẩm
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 70px;">Mã</th>
                            <th style="width: 100px;">Hình ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Danh mục</th>
                            <th>Giá gốc</th>
                            <th>Giá khuyến mãi</th>
                            <th style="width: 25%;">Mô tả</th>
                            <th style="width: 180px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>#@item.Id</strong></td>
                                    <td>
                                        <img src="@item.Image" alt="@item.Name" class="rounded border" style="width: 70px; height: 60px; object-fit: cover;" onerror="this.src='https://placehold.co/100x80?text=No+Image'" />
                                    </td>
                                    <td>
                                        <strong>@item.Name</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @(categoryDict.ContainsKey(item.CategoryId) ? categoryDict[item.CategoryId] : $"Mục #{item.CategoryId}")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-decoration-line-through text-muted small">@item.Price.ToString("N0") đ</span>
                                    </td>
                                    <td>
                                        <strong class="text-danger">@item.SalePrice.ToString("N0") đ</strong>
                                    </td>
                                    <td>
                                        <small class="text-secondary d-inline-block text-truncate" style="max-width: 260px;" title="@item.Description">
                                            @item.Description
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Sửa">
                                                <i class="bi bi-pencil"></i> Sửa
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Chi tiết">
                                                <i class="bi bi-info-circle"></i> Xem
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Xóa">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    Chưa có sản phẩm nào. Vui lòng bấm "Thêm mới sản phẩm".
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
