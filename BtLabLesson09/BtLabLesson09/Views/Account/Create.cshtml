@model BtLabLesson09.Models.Account

@{
    ViewData["Title"] = "Thêm mới tài khoản";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-person-plus"></i> Thêm mới tài khoản (Account Validation)</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Họ và tên -->
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn Nam" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control" placeholder="example@domain.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Số điện thoại (kèm Remote validation) -->
                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label fw-bold"></label>
                            <input asp-for="Phone" class="form-control" placeholder="Ví dụ: 0912345678 (thử nhập 0987654321 để xem báo trùng)" />
                            <div class="form-text text-muted">Hỗ trợ kiểm tra trùng trực tiếp qua Remote Validation (Action VerifyPhone).</div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <!-- Địa chỉ -->
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-bold"></label>
                            <input asp-for="Address" class="form-control" placeholder="Tối đa 35 ký tự" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <!-- Ảnh đại diện -->
                        <div class="mb-3">
                            <label asp-for="Avatar" class="form-label fw-bold"></label>
                            <input asp-for="Avatar" class="form-control" placeholder="Tên file ảnh (VD: avatar.png)" />
                            <span asp-validation-for="Avatar" class="text-danger small"></span>
                        </div>

                        <!-- Ngày sinh -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Birthday" class="form-label fw-bold"></label>
                                <input asp-for="Birthday" type="date" class="form-control" />
                                <span asp-validation-for="Birthday" class="text-danger small"></span>
                            </div>

                            <!-- Giới tính -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Gender" class="form-label fw-bold"></label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="">-- Chọn giới tính --</option>
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Mật khẩu -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold"></label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu..." />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Facebook -->
                        <div class="mb-4">
                            <label asp-for="Facebook" class="form-label fw-bold"></label>
                            <input asp-for="Facebook" class="form-control" placeholder="https://facebook.com/username" />
                            <span asp-validation-for="Facebook" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Quay lại danh sách
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle"></i> Đăng ký tài khoản
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
