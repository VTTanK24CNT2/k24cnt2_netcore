@model IEnumerable<BtLabLesson09.Models.Account>

@{
    ViewData["Title"] = "Danh sách tài khoản";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-people-fill"></i> Danh sách tài khoản (Account)</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus-fill"></i> Thêm mới tài khoản
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Id</th>
                            <th>@Html.DisplayNameFor(model => model.FullName)</th>
                            <th>@Html.DisplayNameFor(model => model.Email)</th>
                            <th>@Html.DisplayNameFor(model => model.Phone)</th>
                            <th>@Html.DisplayNameFor(model => model.Address)</th>
                            <th>@Html.DisplayNameFor(model => model.Birthday)</th>
                            <th>@Html.DisplayNameFor(model => model.Gender)</th>
                            <th>@Html.DisplayNameFor(model => model.Facebook)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>#@item.Id</strong></td>
                                    <td>@item.FullName</td>
                                    <td><a href="mailto:@item.Email">@item.Email</a></td>
                                    <td><span class="badge bg-secondary">@item.Phone</span></td>
                                    <td>@item.Address</td>
                                    <td>@item.Birthday.ToString("dd/MM/yyyy")</td>
                                    <td>@(string.IsNullOrEmpty(item.Gender) ? "Chưa xác định" : item.Gender)</td>
                                    <td>
                                        <a href="@item.Facebook" target="_blank" class="text-primary text-decoration-none">
                                            Facebook cá nhân
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    Chưa có tài khoản nào. Vui lòng bấm "Thêm mới tài khoản".
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
