@model IEnumerable<VttLab06.Models.Book>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3 mb-3">
            <div class="card h-100 p-2 text-center">
                <img src="@item.VttImages" alt="@item.VttTitle" class="card-img-top mx-auto" style="max-height: 150px; object-fit: contain;" />
                <div class="card-body">
                    <h5 class="card-title">@item.VttTitle</h5>
                    <p class="card-text text-danger">Giá: @item.VttPrice.ToString("N0") VNĐ</p>
                </div>
            </div>
        </div>
    }
</div>
