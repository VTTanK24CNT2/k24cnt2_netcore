@model VttLab06.Models.Book
@{
    ViewData["Title"] = "Edit";
}

<h2>Chỉnh sửa sách</h2>

<form action="" method="POST" role="form">

    <div class="form-group">
        <label asp-for="VttTitle">Tên sách</label>
        <input type="text" class="form-control" asp-for="VttTitle" placeholder="Tên sách">
    </div>

    <div class="form-group">
        <label asp-for="VttAuthorID">Tác giả</label>
        <select asp-for="VttAuthorID" class="form-control" asp-items="@ViewBag.authors">
            <option value="">Chọn tác giả</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="VttGenreId">Thể loại</label>
        <select asp-for="VttGenreId" class="form-control" asp-items="@ViewBag.genres">
            <option value="">Chọn Thể loại</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="VttPrice">Giá sách</label>
        <input type="text" class="form-control" asp-for="VttPrice" placeholder="Giá sách">
    </div>

    <div class="form-group">
        <label asp-for="VttTotalPage">Tổng số trang</label>
        <input type="text" class="form-control" asp-for="VttTotalPage" placeholder="Tổng số trang">
    </div>

    <div class="form-group">
        <label asp-for="VttImages">Hình ảnh/ Poster</label>
        <input type="file" class="form-control" asp-for="VttImages">
    </div>

    <div class="form-group">
        <label asp-for="VttSumary">Giới thiệu ngắn</label>
        <textarea class="form-control" asp-for="VttSumary" placeholder="Nội dung giới thiệu sách..."></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Lưu lại</button>
</form>