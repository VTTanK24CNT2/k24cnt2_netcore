@model IEnumerable<VttLab06.Models.Book>
@foreach (var item in Model )
{
    <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3">
        <div class="thumbnail">
            <img src="@item.VttImages" alt="" >
            <div class="caption">
                <h3>@item.VttTitle</h3>
                <p>
                    Price: @item.VttPrice
                </p>
            </div>
        </div>
    </div>
}