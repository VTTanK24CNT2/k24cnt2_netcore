@model QLCamDo_Nhom4_LopK24CNT2.Models.ViewModels.GiaoDichCreateViewModel

@{
    ViewData["Title"] = "Lập giao dịch thu tiền";
    Layout = "_Layout";
    var hopDong = ViewBag.HopDong as QLCamDo_Nhom4_LopK24CNT2.Models.HopDongCam;
    decimal tienLaiTamTinh = ViewBag.TienLaiTamTinh != null ? (decimal)ViewBag.TienLaiTamTinh : 0;
    decimal tongLaiDaDong = ViewBag.TongLaiDaDong != null ? (decimal)ViewBag.TongLaiDaDong : 0;
    decimal tienLaiConLai = ViewBag.TienLaiConLai != null ? (decimal)ViewBag.TienLaiConLai : 0;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <h4 class="fw-bold mb-3"><i class="bi bi-cash-coin text-success me-2"></i>Lập Giao Dịch Thu Tiền</h4>
                <p class="text-muted small mb-4">Ghi nhận thu tiền đóng lãi, gia hạn hạn chuộc hoặc tất toán chuộc tài sản</p>

                @if (hopDong != null)
                {
                    <div class="alert alert-light border rounded-3 p-3 mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0 text-dark">Hợp đồng: HD-@hopDong.MaHd - @hopDong.MaKhNavigation.HoTen</h6>
                            <span class="badge bg-primary">Gốc: @hopDong.TienCam.ToString("N0") đ</span>
                        </div>
                        <div class="row mt-2 small text-muted">
                            <div class="col-6">Hạn chuộc: <strong>@hopDong.HanChuoc.ToString("dd/MM/yyyy")</strong></div>
                            <div class="col-6">Lãi suất: <strong>@hopDong.LaiSuat%/ngày</strong></div>
                            <div class="col-6 mt-1">Lãi tạm tính hôm nay: <strong class="text-danger">@tienLaiTamTinh.ToString("N0") đ</strong></div>
                            <div class="col-6 mt-1">Lãi còn phải đóng: <strong class="text-danger">@tienLaiConLai.ToString("N0") đ</strong></div>
                        </div>
                    </div>
                }

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    @if (hopDong != null)
                    {
                        <input type="hidden" asp-for="MaHd" />
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="MaHd" class="form-label fw-semibold"></label>
                            <select asp-for="MaHd" class="form-select" asp-items="ViewBag.HopDongList">
                                <option value="">-- Chọn hợp đồng cần thanh toán --</option>
                            </select>
                            <span asp-validation-for="MaHd" class="text-danger small"></span>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="LoaiGd" class="form-label fw-semibold"></label>
                        <select asp-for="LoaiGd" class="form-select" id="selectLoaiGd">
                            <option value="đóng lãi">Đóng tiền lãi định kỳ</option>
                            <option value="gia hạn">Đóng lãi & Gia hạn hạn chuộc</option>
                            <option value="chuộc">Tất toán chuộc lại đồ (Gốc + Lãi)</option>
                        </select>
                        <span asp-validation-for="LoaiGd" class="text-danger small"></span>
                    </div>

                    <div class="mb-3" id="giaHanBox" style="display: none;">
                        <label asp-for="GiaHanDenNgay" class="form-label fw-semibold text-info"></label>
                        <input asp-for="GiaHanDenNgay" type="date" class="form-control" />
                        <span asp-validation-for="GiaHanDenNgay" class="text-danger small"></span>
                        <div class="form-text small">Hạn chuộc mới sau khi khách hoàn thành đóng lãi gia hạn.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SoTien" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="SoTien" id="txtSoTien" type="number" class="form-control form-control-lg fw-bold text-success" />
                            <span class="input-group-text fw-bold">VNĐ</span>
                        </div>
                        <span asp-validation-for="SoTien" class="text-danger small"></span>
                        <div class="form-text small text-muted">Số tiền thu thực tế từ khách hàng (phải lớn hơn 0).</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="GhiChu" class="form-label fw-semibold"></label>
                        <input asp-for="GhiChu" class="form-control" placeholder="Ghi chú thêm (nếu có)..." />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success px-4 py-2 rounded-3 fw-bold">
                            <i class="bi bi-printer me-1"></i>Xác nhận & In Biên Nhận
                        </button>
                        @if (hopDong != null)
                        {
                            <a asp-controller="HopDongCam" asp-action="Details" asp-route-id="@hopDong.MaHd" class="btn btn-light px-4 py-2">Quay lại</a>
                        }
                        else
                        {
                            <a asp-action="Index" class="btn btn-light px-4 py-2">Hủy</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function checkLoaiGd() {
            const val = $('#selectLoaiGd').val();
            if (val === 'gia hạn') {
                $('#giaHanBox').slideDown();
            } else {
                $('#giaHanBox').slideUp();
            }
        }

        $('#selectLoaiGd').on('change', checkLoaiGd);
        $(document).ready(function () {
            checkLoaiGd();
        });
    </script>
}
