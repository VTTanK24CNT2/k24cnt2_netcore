@model QLCamDo_Nhom4_LopK24CNT2.Models.GiaoDich

@{
    Layout = null;
    var hd = Model.MaHdNavigation;
    var kh = hd.MaKhNavigation;
    var ts = hd.TaiSans.FirstOrDefault();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Biên Nhận Thu Tiền #GD-@Model.MaGd - @kh.HoTen</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            color: #000;
            background: #fff;
            padding: 20px;
            font-size: 15px;
        }
        .receipt-box {
            max-width: 650px;
            margin: auto;
            border: 2px dashed #444;
            padding: 25px;
            border-radius: 8px;
        }
        @@media print {
            .no-print {
                display: none !important;
            }
            body {
                padding: 0;
            }
            .receipt-box {
                border: 1px solid #000;
            }
        }
    </style>
</head>
<body>
    <div class="no-print text-center mb-3">
        <button onclick="window.print()" class="btn btn-success px-4 py-2 fw-bold">
            🖨️ In Biên Nhận Này
        </button>
        <button onclick="window.close()" class="btn btn-secondary px-3 py-2 ms-2">
            Đóng
        </button>
    </div>

    <div class="receipt-box">
        <div class="row align-items-center mb-3">
            <div class="col-8">
                <h5 class="fw-bold mb-0">CỬA HÀNG CẦM ĐỒ C</h5>
                <small class="text-muted d-block">Địa chỉ: 123 Đường Cầm Đồ, Hà Nội</small>
                <small class="text-muted">Hotline: 1900 6868</small>
            </div>
            <div class="col-4 text-end">
                <span class="badge bg-dark fs-6">GD-@Model.MaGd</span>
                <div class="small text-muted mt-1">@Model.NgayGd.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <hr />
        <div class="text-center my-3">
            <h4 class="fw-bold text-uppercase mb-1">BIÊN NHẬN THU TIỀN</h4>
            <span class="badge bg-secondary">LOẠI GIAO DỊCH: @Model.LoaiGd.ToUpper()</span>
        </div>

        <div class="mb-3">
            <p class="mb-1">Họ tên khách hàng: <strong>@kh.HoTen</strong></p>
            <p class="mb-1">Số CCCD: <strong>@kh.SoCccd</strong> &nbsp;|&nbsp; Điện thoại: <strong>@kh.SoDienThoai</strong></p>
            <p class="mb-1">Mã hợp đồng liên kết: <strong>HD-@hd.MaHd</strong></p>
            <p class="mb-1">Tài sản cầm cố: <strong>@(ts != null ? ts.TenTaiSan : "Tài sản")</strong></p>
        </div>

        <div class="p-3 bg-light rounded border text-center my-3">
            <span class="text-muted d-block small">SỐ TIỀN ĐÃ THU:</span>
            <h3 class="fw-bold text-success mb-0">@Model.SoTien.ToString("N0") VNĐ</h3>
        </div>

        <div class="mb-4">
            <p class="mb-1">Nội dung thanh toán: <strong>Thu tiền @Model.LoaiGd theo hợp đồng HD-@hd.MaHd</strong></p>
            <p class="mb-1">Hạn chuộc hiện tại: <strong>@hd.HanChuoc.ToString("dd/MM/yyyy")</strong></p>
            <p class="mb-0">Trạng thái hợp đồng sau giao dịch: <strong class="text-uppercase">@hd.TrangThai</strong></p>
        </div>

        <div class="row text-center mt-4">
            <div class="col-6">
                <h6 class="fw-bold text-uppercase">NGƯỜI NỘP TIỀN</h6>
                <p class="fst-italic text-muted small">(Ký và ghi rõ họ tên)</p>
                <div style="height: 60px;"></div>
                <p class="fw-bold">@kh.HoTen</p>
            </div>
            <div class="col-6">
                <h6 class="fw-bold text-uppercase">NGƯỜI THU TIỀN</h6>
                <p class="fst-italic text-muted small">(Ký và ghi rõ họ tên)</p>
                <div style="height: 60px;"></div>
                <p class="fw-bold">@Model.NhanVienThu</p>
            </div>
        </div>
    </div>
</body>
</html>
