@model IEnumerable<QLCamDo_Nhom4_LopK24CNT2.Models.GiaoDich>

@{
    ViewData["Title"] = "Quản lý giao dịch & thu lãi";
    Layout = "_Layout";

    int? currentMaHd = ViewBag.CurrentMaHd as int?;
    string? currentLoaiGd = ViewBag.CurrentLoaiGd as string;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalItems = ViewBag.TotalItems;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-cash-stack text-success me-2"></i>Lịch Sử Giao Dịch & Thu Lãi</h3>
        <p class="text-muted small mb-0">Theo dõi toàn bộ dòng tiền đóng lãi, gia hạn hợp đồng và tất toán chuộc đồ</p>
    </div>
    @if (!User.IsInRole("Khách hàng"))
    {
        <a asp-action="Create" class="btn btn-success rounded-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i>Lập giao dịch thu tiền
        </a>
    }
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">Mã HĐ:</span>
                    <input type="number" name="maHd" class="form-control border-start-0" placeholder="Nhập mã hợp đồng (ví dụ: 1)" value="@currentMaHd" />
                </div>
            </div>
            <div class="col-md-5">
                <select name="loaiGd" class="form-select">
                    <option value="">-- Tất cả loại giao dịch --</option>
                    <option value="đóng lãi" selected="@(currentLoaiGd == "đóng lãi")">Đóng tiền lãi</option>
                    <option value="gia hạn" selected="@(currentLoaiGd == "gia hạn")">Gia hạn hạn chuộc</option>
                    <option value="chuộc" selected="@(currentLoaiGd == "chuộc")">Chuộc đồ (Tất toán)</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-1">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Lọc</button>
                @if (currentMaHd.HasValue || !string.IsNullOrEmpty(currentLoaiGd))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Mã GD</th>
                    <th>Thời gian giao dịch</th>
                    <th>Hợp đồng & Khách</th>
                    <th>Loại giao dịch</th>
                    <th>Số tiền thu (VNĐ)</th>
                    <th>Nhân viên thu</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Không có giao dịch nào phù hợp!
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">GD-@item.MaGd</td>
                            <td>
                                <div><i class="bi bi-calendar2 me-1 text-muted"></i>@item.NgayGd.ToString("dd/MM/yyyy")</div>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>@item.NgayGd.ToString("HH:mm:ss")</small>
                            </td>
                            <td>
                                <div><a asp-controller="HopDongCam" asp-action="Details" asp-route-id="@item.MaHd" class="fw-semibold text-decoration-none">HD-@item.MaHd</a></div>
                                <small class="text-muted">@item.MaHdNavigation?.MaKhNavigation?.HoTen</small>
                            </td>
                            <td>
                                @if (item.LoaiGd == "chuộc")
                                {
                                    <span class="badge bg-success px-2 py-1"><i class="bi bi-box-arrow-right me-1"></i>Tất toán chuộc</span>
                                }
                                else if (item.LoaiGd == "gia hạn")
                                {
                                    <span class="badge bg-info text-dark px-2 py-1"><i class="bi bi-arrow-repeat me-1"></i>Gia hạn</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary px-2 py-1"><i class="bi bi-cash-coin me-1"></i>Đóng tiền lãi</span>
                                }
                            </td>
                            <td>
                                <span class="fs-6 fw-bold text-success">+@item.SoTien.ToString("N0") đ</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-person me-1"></i>@item.NhanVienThu
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="InBienNhan" asp-route-id="@item.MaGd" target="_blank" class="btn btn-outline-secondary" title="In biên lai">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.MaGd" class="btn btn-outline-info" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Chủ cửa hàng"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.MaGd" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy giao dịch GD-@item.MaGd không? Thao tác này sẽ ghi audit log!');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa giao dịch">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <small class="text-muted">Tổng cộng <strong>@totalItems</strong> giao dịch (Trang @currentPage/@totalPages)</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-maHd="@currentMaHd" asp-route-loaiGd="@currentLoaiGd">Trước</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(currentPage == p ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-maHd="@currentMaHd" asp-route-loaiGd="@currentLoaiGd">@p</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-maHd="@currentMaHd" asp-route-loaiGd="@currentLoaiGd">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
