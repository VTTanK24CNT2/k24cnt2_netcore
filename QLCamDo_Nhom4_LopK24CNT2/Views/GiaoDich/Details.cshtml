@model QLCamDo_Nhom4_LopK24CNT2.Models.GiaoDich

@{
    ViewData["Title"] = "Chi tiết giao dịch GD-" + Model.MaGd;
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-receipt text-success me-2"></i>Giao Dịch GD-@Model.MaGd</h4>
                    <span class="badge bg-success fs-6">Thành công</span>
                </div>
                <hr />

                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Loại giao dịch:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.LoaiGd.ToUpper()</dd>

                    <dt class="col-sm-4 text-muted">Thời gian:</dt>
                    <dd class="col-sm-8">@Model.NgayGd.ToString("dd/MM/yyyy HH:mm:ss")</dd>

                    <dt class="col-sm-4 text-muted">Số tiền thu:</dt>
                    <dd class="col-sm-8 fs-5 fw-bold text-success">@Model.SoTien.ToString("N0") VNĐ</dd>

                    <dt class="col-sm-4 text-muted">Hợp đồng liên quan:</dt>
                    <dd class="col-sm-8">
                        <a asp-controller="HopDongCam" asp-action="Details" asp-route-id="@Model.MaHd">HD-@Model.MaHd</a>
                    </dd>

                    <dt class="col-sm-4 text-muted">Khách hàng:</dt>
                    <dd class="col-sm-8">@Model.MaHdNavigation.MaKhNavigation.HoTen (CCCD: @Model.MaHdNavigation.MaKhNavigation.SoCccd)</dd>

                    <dt class="col-sm-4 text-muted">Nhân viên thu tiền:</dt>
                    <dd class="col-sm-8">@Model.NhanVienThu</dd>
                </dl>

                <div class="d-flex gap-2">
                    <a asp-action="InBienNhan" asp-route-id="@Model.MaGd" target="_blank" class="btn btn-secondary">
                        <i class="bi bi-printer me-1"></i>In biên nhận
                    </a>
                    <a asp-controller="HopDongCam" asp-action="Details" asp-route-id="@Model.MaHd" class="btn btn-outline-primary">Xem hợp đồng</a>
                    <a asp-action="Index" class="btn btn-light">Danh sách giao dịch</a>
                </div>
            </div>
        </div>
    </div>
</div>
