@model QLCamDo_Nhom4_LopK24CNT2.Models.LoaiTaiSan

@{
    ViewData["Title"] = "Xóa loại tài sản";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4 border-danger">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-2 text-danger mb-3">
                    <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                    <h4 class="fw-bold mb-0">Xác nhận xóa loại tài sản</h4>
                </div>
                <p class="text-muted">Bạn có chắc chắn muốn xóa loại tài sản sau đây không?</p>
                <div class="alert alert-light border">
                    <p class="mb-1"><strong>Mã loại:</strong> #@Model.MaLoai</p>
                    <p class="mb-1"><strong>Tên loại:</strong> @Model.TenLoai</p>
                    <p class="mb-1"><strong>Lãi suất ngày:</strong> @Model.LaiSuatNgay %</p>
                    <p class="mb-0"><strong>Số tài sản liên kết:</strong> @Model.TaiSans.Count</p>
                </div>

                @if (Model.TaiSans.Any())
                {
                    <div class="alert alert-warning small">
                        <i class="bi bi-exclamation-circle me-1"></i> Không thể xóa vì đã có @Model.TaiSans.Count tài sản thuộc loại này!
                    </div>
                }

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaLoai" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger px-4" @(Model.TaiSans.Any() ? "disabled" : "")>
                            <i class="bi bi-trash me-1"></i> Xóa vĩnh viễn
                        </button>
                        <a asp-action="Index" class="btn btn-light px-4">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
