@model QLCamDo_Nhom4_LopK24CNT2.Models.LoaiTaiSan

@{
    ViewData["Title"] = "Chi tiết loại tài sản";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0"><i class="bi bi-tag-fill text-primary me-2"></i>Chi tiết loại tài sản</h4>
                    <span class="badge bg-primary fs-6">Mã #@Model.MaLoai</span>
                </div>
                <hr />
                <dl class="row mb-4">
                    <dt class="col-sm-4 text-muted">Tên loại tài sản:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.TenLoai</dd>

                    <dt class="col-sm-4 text-muted">Lãi suất theo ngày:</dt>
                    <dd class="col-sm-8 text-primary fw-bold">@Model.LaiSuatNgay.ToString("0.00") % / ngày</dd>

                    <dt class="col-sm-4 text-muted">Thời hạn tối đa:</dt>
                    <dd class="col-sm-8">@Model.SoNgayToiDa ngày</dd>

                    <dt class="col-sm-4 text-muted">Tổng số tài sản:</dt>
                    <dd class="col-sm-8">@Model.TaiSans.Count tài sản</dd>
                </dl>

                @if (Model.TaiSans.Any())
                {
                    <h6 class="fw-bold mt-4 mb-2">Danh sách tài sản thuộc loại này:</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã TS</th>
                                    <th>Tên tài sản</th>
                                    <th>Giá trị định giá</th>
                                    <th>Mã HĐ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ts in Model.TaiSans)
                                {
                                    <tr>
                                        <td>TS-@ts.MaTs</td>
                                        <td>@ts.TenTaiSan</td>
                                        <td>@((ts.GiaTriDinhGia ?? 0).ToString("N0")) VNĐ</td>
                                        <td><a asp-controller="HopDongCam" asp-action="Details" asp-route-id="@ts.MaHd">HD-@ts.MaHd</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="d-flex gap-2 mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.MaLoai" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Chỉnh sửa</a>
                    <a asp-action="Index" class="btn btn-light">Quay lại danh sách</a>
                </div>
            </div>
        </div>
    </div>
</div>
