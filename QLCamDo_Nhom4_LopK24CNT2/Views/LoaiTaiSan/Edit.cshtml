@model QLCamDo_Nhom4_LopK24CNT2.Models.LoaiTaiSan

@{
    ViewData["Title"] = "Chỉnh sửa loại tài sản";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3"><i class="bi bi-pencil-square text-warning me-2"></i>Chỉnh sửa loại tài sản</h4>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaLoai" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="TenLoai" class="form-label fw-semibold"></label>
                        <input asp-for="TenLoai" class="form-control" />
                        <span asp-validation-for="TenLoai" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LaiSuatNgay" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="LaiSuatNgay" type="number" step="0.01" class="form-control" />
                            <span class="input-group-text">%/ngày</span>
                        </div>
                        <span asp-validation-for="LaiSuatNgay" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SoNgayToiDa" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="SoNgayToiDa" type="number" class="form-control" />
                            <span class="input-group-text">ngày</span>
                        </div>
                        <span asp-validation-for="SoNgayToiDa" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning text-dark px-4"><i class="bi bi-check-lg me-1"></i>Lưu thay đổi</button>
                        <a asp-action="Index" class="btn btn-light px-4">Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
