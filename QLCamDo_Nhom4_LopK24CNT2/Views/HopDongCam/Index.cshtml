@model IEnumerable<QLCamDo_Nhom4_LopK24CNT2.Models.HopDongCam>

@{
    ViewData["Title"] = "Quản lý hợp đồng cầm đồ";
    Layout = "_Layout";

    var search = ViewBag.CurrentSearch as string;
    var trangThai = ViewBag.CurrentTrangThai as string;
    int? maLoai = ViewBag.CurrentMaLoai as int?;
    DateOnly? tuNgay = ViewBag.CurrentTuNgay as DateOnly?;
    DateOnly? denNgay = ViewBag.CurrentDenNgay as DateOnly?;
    var sapDenHan = ViewBag.CurrentSapDenHan as string;

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalItems = ViewBag.TotalItems;

    var today = DateOnly.FromDateTime(DateTime.Now);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-file-earmark-text-fill text-primary me-2"></i>Quản lý Hợp Đồng Cầm Đồ</h3>
        <p class="text-muted small mb-0">Theo dõi hợp đồng, tự động tính lãi theo ngày, kiểm soát hạn chuộc và xử lý quá hạn</p>
    </div>
    @if (!User.IsInRole("Khách hàng"))
    {
        <a asp-action="Create" class="btn btn-primary rounded-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i>Lập hợp đồng mới
        </a>
    }
</div>

<!-- Bộ lọc tìm kiếm nâng cao (Được lưu tự động trong Cookie) -->
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Từ khóa tìm kiếm</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Mã HĐ, tên khách, CCCD, tài sản..." value="@search" />
                </div>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">Trạng thái hợp đồng</label>
                <select name="trangThai" class="form-select">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="đang cầm" selected="@(trangThai == "đang cầm")">Đang cầm</option>
                    <option value="quá hạn" selected="@(trangThai == "quá hạn")">Quá hạn</option>
                    <option value="thanh lý" selected="@(trangThai == "thanh lý")">Thanh lý</option>
                    <option value="đã chuộc" selected="@(trangThai == "đã chuộc")">Đã chuộc</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary">Loại tài sản</label>
                <select name="maLoai" class="form-select" asp-items="ViewBag.LoaiTaiSans">
                    <option value="">-- Tất cả loại --</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Khoảng ngày cầm</label>
                <div class="input-group">
                    <input type="date" name="tuNgay" class="form-control form-control-sm" value="@(tuNgay?.ToString("yyyy-MM-dd"))" title="Từ ngày" />
                    <span class="input-group-text p-1">-</span>
                    <input type="date" name="denNgay" class="form-control form-control-sm" value="@(denNgay?.ToString("yyyy-MM-dd"))" title="Đến ngày" />
                </div>
            </div>

            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Lọc</button>
                <a asp-action="Index" asp-route-resetFilter="true" class="btn btn-outline-secondary" title="Đặt lại bộ lọc (Xóa Cookie)"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>

            <div class="col-12 mt-2 pt-2 border-top d-flex gap-2">
                <a asp-action="Index" asp-route-sapDenHan="true" class="badge @(sapDenHan == "true" ? "bg-warning text-dark" : "bg-light text-dark border") text-decoration-none px-3 py-2">
                    <i class="bi bi-alarm me-1"></i> Sắp đến hạn (trong 3 ngày tới)
                </a>
                <a asp-action="Index" asp-route-trangThai="quá hạn" class="badge @(trangThai == "quá hạn" ? "bg-danger" : "bg-light text-dark border") text-decoration-none px-3 py-2">
                    <i class="bi bi-exclamation-triangle me-1"></i> Quá hạn chuộc
                </a>
                <a asp-action="Index" asp-route-trangThai="thanh lý" class="badge @(trangThai == "thanh lý" ? "bg-purple text-white bg-dark" : "bg-light text-dark border") text-decoration-none px-3 py-2">
                    <i class="bi bi-tag me-1"></i> Tài sản thanh lý
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách hợp đồng -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Mã HĐ</th>
                    <th>Khách hàng</th>
                    <th>Tài sản cầm cố</th>
                    <th>Tiền cầm (VNĐ)</th>
                    <th>Lãi suất</th>
                    <th>Ngày cầm - Hạn chuộc</th>
                    <th>Lãi tạm tính</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
                            Không có hợp đồng nào phù hợp với bộ lọc hiện tại!
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var isSapDenHan = item.TrangThai == "đang cầm" && item.HanChuoc >= today && item.HanChuoc <= today.AddDays(3);
                        var isQuaHan = (item.TrangThai == "quá hạn") || (item.TrangThai == "đang cầm" && item.HanChuoc < today);
                        var tienLaiTamTinh = QLCamDo_Nhom4_LopK24CNT2.Helpers.InterestCalculator.GetCurrentInterest(item);

                        <tr class="@(isSapDenHan ? "table-warning bg-opacity-25" : "")">
                            <td class="ps-4 fw-bold text-dark">
                                HD-@item.MaHd
                            </td>
                            <td>
                                <div class="fw-bold">@item.MaKhNavigation.HoTen</div>
                                <small class="text-muted">CCCD: @item.MaKhNavigation.SoCccd</small>
                            </td>
                            <td>
                                @if (item.TaiSans.Any())
                                {
                                    var ts = item.TaiSans.First();
                                    var img = ts.AnhTaiSan?.Split(';', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(img))
                                        {
                                            <img src="@img" class="asset-thumbnail-sm shadow-sm" alt="@ts.TenTaiSan" />
                                        }
                                        else
                                        {
                                            <div class="asset-thumbnail-sm bg-light d-flex align-items-center justify-content-center text-muted">
                                                <i class="bi bi-box"></i>
                                            </div>
                                        }
                                        <div>
                                            <span class="fw-semibold text-dark">@ts.TenTaiSan</span>
                                            <div class="d-flex gap-1 align-items-center mt-1">
                                                <span class="badge bg-light text-dark border">@ts.MaLoaiNavigation?.TenLoai</span>
                                                <small class="text-muted">Định giá: @((ts.GiaTriDinhGia ?? 0).ToString("N0")) đ</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted italic">Chưa có tài sản</span>
                                }
                            </td>
                            <td>
                                <span class="fw-bold text-primary fs-6">@item.TienCam.ToString("N0") đ</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.LaiSuat.ToString("0.00")%/ngày</span>
                            </td>
                            <td>
                                <div><i class="bi bi-calendar2 me-1 text-muted"></i>@item.NgayCam.ToString("dd/MM/yyyy")</div>
                                <div class="@(isQuaHan ? "text-danger fw-bold" : (isSapDenHan ? "text-warning fw-bold" : "text-muted"))">
                                    <i class="bi bi-clock me-1"></i>Hạn: @item.HanChuoc.ToString("dd/MM/yyyy")
                                </div>
                            </td>
                            <td>
                                <span class="fw-semibold text-danger">@tienLaiTamTinh.ToString("N0") đ</span>
                            </td>
                            <td>
                                @if (item.TrangThai == "đang cầm")
                                {
                                    if (isSapDenHan)
                                    {
                                        <span class="badge badge-status-sapdenhan"><i class="bi bi-alarm me-1"></i>Sắp đến hạn</span>
                                    }
                                    else if (isQuaHan)
                                    {
                                        <span class="badge badge-status-quahan"><i class="bi bi-exclamation-triangle me-1"></i>Quá hạn</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-status-dangcam"><i class="bi bi-check2 me-1"></i>Đang cầm</span>
                                    }
                                }
                                else if (item.TrangThai == "quá hạn")
                                {
                                    <span class="badge badge-status-quahan"><i class="bi bi-exclamation-triangle me-1"></i>Quá hạn</span>
                                }
                                else if (item.TrangThai == "thanh lý")
                                {
                                    <span class="badge badge-status-thanhly"><i class="bi bi-tag me-1"></i>Thanh lý</span>
                                }
                                else
                                {
                                    <span class="badge badge-status-dachuoc"><i class="bi bi-check-all me-1"></i>Đã chuộc</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.MaHd" class="btn btn-outline-info" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="InHopDong" asp-route-id="@item.MaHd" class="btn btn-outline-secondary" title="In hợp đồng">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                    @if (!User.IsInRole("Khách hàng"))
                                    {
                                        @if (item.TrangThai != "đã chuộc")
                                        {
                                            <a asp-controller="GiaoDich" asp-action="Create" asp-route-maHd="@item.MaHd" class="btn btn-outline-success" title="Thu lãi / Gia hạn / Chuộc đồ">
                                                <i class="bi bi-cash-coin"></i>
                                            </a>
                                        }
                                        <a asp-action="Edit" asp-route-id="@item.MaHd" class="btn btn-outline-warning" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (User.IsInRole("Chủ cửa hàng"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.MaHd" class="btn btn-outline-danger" title="Xóa hợp đồng">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <small class="text-muted">Tổng cộng <strong>@totalItems</strong> hợp đồng (Trang @currentPage/@totalPages)</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" 
                           asp-route-search="@search" asp-route-trangThai="@trangThai" asp-route-maLoai="@maLoai" 
                           asp-route-tuNgay="@tuNgay" asp-route-denNgay="@denNgay" asp-route-sapDenHan="@sapDenHan">Trước</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(currentPage == p ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p"
                               asp-route-search="@search" asp-route-trangThai="@trangThai" asp-route-maLoai="@maLoai" 
                               asp-route-tuNgay="@tuNgay" asp-route-denNgay="@denNgay" asp-route-sapDenHan="@sapDenHan">@p</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)"
                           asp-route-search="@search" asp-route-trangThai="@trangThai" asp-route-maLoai="@maLoai" 
                           asp-route-tuNgay="@tuNgay" asp-route-denNgay="@denNgay" asp-route-sapDenHan="@sapDenHan">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
