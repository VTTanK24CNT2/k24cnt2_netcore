@model QLCamDo_Nhom4_LopK24CNT2.Models.HopDongCam

@{
    ViewData["Title"] = "Chỉnh sửa hợp đồng HD-" + Model.MaHd;
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3"><i class="bi bi-pencil-square text-warning me-2"></i>Chỉnh sửa Hợp đồng HD-@Model.MaHd</h4>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaHd" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="MaKh" class="form-label fw-semibold"></label>
                        <select asp-for="MaKh" class="form-select" asp-items="ViewBag.KhachHangs"></select>
                        <span asp-validation-for="MaKh" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="NgayCam" class="form-label fw-semibold"></label>
                            <input asp-for="NgayCam" type="date" class="form-control" />
                            <span asp-validation-for="NgayCam" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="HanChuoc" class="form-label fw-semibold"></label>
                            <input asp-for="HanChuoc" type="date" class="form-control" />
                            <span asp-validation-for="HanChuoc" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TienCam" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="TienCam" type="number" class="form-control" />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                            <span asp-validation-for="TienCam" class="text-danger small"></span>
                            <div class="form-text small text-warning"><i class="bi bi-info-circle me-1"></i>Hệ thống tự động ghi nhật ký (Audit Log) nếu thay đổi số tiền!</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LaiSuat" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="LaiSuat" type="number" step="0.01" class="form-control" />
                                <span class="input-group-text">%/ngày</span>
                            </div>
                            <span asp-validation-for="LaiSuat" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="TrangThai" class="form-label fw-semibold"></label>
                        <select asp-for="TrangThai" class="form-select" asp-items="ViewBag.TrangThaiList"></select>
                        <span asp-validation-for="TrangThai" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning text-dark px-4"><i class="bi bi-check-lg me-1"></i>Lưu thay đổi</button>
                        <a asp-action="Details" asp-route-id="@Model.MaHd" class="btn btn-light px-4">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
