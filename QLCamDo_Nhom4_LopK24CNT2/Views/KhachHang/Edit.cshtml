@model QLCamDo_Nhom4_LopK24CNT2.Models.KhachHang

@{
    ViewData["Title"] = "Chỉnh sửa thông tin khách hàng";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3"><i class="bi bi-pencil-square text-warning me-2"></i>Chỉnh sửa thông tin khách hàng</h4>

                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaKh" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="HoTen" class="form-label fw-semibold"></label>
                        <input asp-for="HoTen" class="form-control" />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="SoCccd" class="form-label fw-semibold"></label>
                            <input asp-for="SoCccd" class="form-control" maxlength="12" />
                            <span asp-validation-for="SoCccd" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SoDienThoai" class="form-label fw-semibold"></label>
                            <input asp-for="SoDienThoai" class="form-control" maxlength="10" />
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DiaChi" class="form-label fw-semibold"></label>
                        <input asp-for="DiaChi" class="form-control" />
                        <span asp-validation-for="DiaChi" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Ảnh chụp thẻ CCCD (Chọn nếu muốn thay đổi)</label>
                        <input name="anhCccdFile" type="file" class="form-control" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.AnhCccd))
                        {
                            <div class="mt-2 small text-muted">
                                <span>Ảnh CCCD hiện tại: </span>
                                <a href="@Model.AnhCccd" target="_blank" class="text-primary text-decoration-none">Xem ảnh hiện tại</a>
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning text-dark px-4"><i class="bi bi-check-lg me-1"></i>Lưu thay đổi</button>
                        <a asp-action="Index" class="btn btn-light px-4">Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
