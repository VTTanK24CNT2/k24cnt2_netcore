@model QLCamDo_Nhom4_LopK24CNT2.Models.KhachHang

@{
    ViewData["Title"] = "Thêm mới khách hàng";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3"><i class="bi bi-person-plus text-primary me-2"></i>Thêm mới khách hàng</h4>

                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="HoTen" class="form-label fw-semibold"></label>
                        <input asp-for="HoTen" class="form-control" placeholder="Nguyễn Văn A" />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="SoCccd" class="form-label fw-semibold"></label>
                            <input asp-for="SoCccd" class="form-control" placeholder="12 chữ số" maxlength="12" />
                            <span asp-validation-for="SoCccd" class="text-danger small"></span>
                            <div class="form-text small">Đúng 12 chữ số theo quy định CCCD gắn chip</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SoDienThoai" class="form-label fw-semibold"></label>
                            <input asp-for="SoDienThoai" class="form-control" placeholder="09xxxxxxxx" maxlength="10" />
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DiaChi" class="form-label fw-semibold"></label>
                        <input asp-for="DiaChi" class="form-control" placeholder="Số nhà, đường, phường/xã, quận/huyện..." />
                        <span asp-validation-for="DiaChi" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Ảnh chụp thẻ CCCD</label>
                        <input name="anhCccdFile" type="file" class="form-control" accept="image/*" />
                        <div class="form-text small">Chỉ Nhân viên và Quản trị mới được phép xem ảnh CCCD bảo mật này.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i>Lưu khách hàng</button>
                        <a asp-action="Index" class="btn btn-light px-4">Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
