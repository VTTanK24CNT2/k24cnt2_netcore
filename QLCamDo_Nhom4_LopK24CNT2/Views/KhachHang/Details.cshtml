@model QLCamDo_Nhom4_LopK24CNT2.Models.KhachHang

@{
    ViewData["Title"] = "Hồ sơ khách hàng: " + Model.HoTen;
    Layout = "_Layout";
    bool canViewCccd = User.IsInRole("Chủ cửa hàng") || User.IsInRole("Nhân viên");
}

<div class="row">
    <!-- Cột thông tin khách hàng -->
    <div class="col-lg-5 mb-4">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-person-lines-fill text-primary me-2"></i>Thông tin cá nhân</h4>
                    <span class="badge bg-secondary fs-6">KH-@Model.MaKh</span>
                </div>
                <hr />

                <div class="text-center mb-4">
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex mb-2">
                        <i class="bi bi-person-circle fs-1"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-1">@Model.HoTen</h4>
                    <div class="text-muted"><i class="bi bi-telephone me-1"></i>@Model.SoDienThoai</div>
                </div>

                <div class="list-group list-group-flush mb-4">
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Số CCCD (12 số):</span>
                        <span class="fw-bold font-monospace bg-light px-2 py-1 rounded border">@Model.SoCccd</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Số điện thoại:</span>
                        <span class="fw-bold">@Model.SoDienThoai</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Địa chỉ:</span>
                        <span class="fw-bold text-end">@(Model.DiaChi ?? "Chưa có địa chỉ")</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span class="text-muted">Tổng số hợp đồng:</span>
                        <span class="badge bg-primary fs-6">@Model.HopDongCams.Count hợp đồng</span>
                    </div>
                </div>

                <!-- Bảo mật: Ảnh CCCD chỉ nhân viên/Admin được xem -->
                <div class="mt-4">
                    <h6 class="fw-bold text-secondary mb-2"><i class="bi bi-shield-check text-success me-1"></i>Ảnh Thẻ CCCD Gắn Chip Thực Tế:</h6>
                    @if (canViewCccd)
                    {
                        if (!string.IsNullOrEmpty(Model.AnhCccd))
                        {
                            <div class="cccd-card p-3 text-center">
                                <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                                    <span class="badge bg-success small"><i class="bi bi-patch-check-fill me-1"></i>ĐÃ XÁC THỰC CCCD</span>
                                    <small class="text-success font-monospace fw-bold">12 SỐ</small>
                                </div>
                                <img src="@Model.AnhCccd" alt="CCCD @Model.HoTen" class="img-fluid rounded border shadow-sm" style="max-height: 250px;" />
                                <div class="mt-3">
                                    <a href="@Model.AnhCccd" target="_blank" class="btn btn-sm btn-outline-success fw-semibold">
                                        <i class="bi bi-arrows-fullscreen me-1"></i>Xem ảnh gốc độ phân giải cao
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning small mb-0">
                                <i class="bi bi-info-circle me-1"></i>Khách hàng chưa tải lên ảnh thẻ CCCD.
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-secondary small mb-0">
                            <i class="bi bi-lock-fill me-1"></i>Ảnh thẻ CCCD được bảo mật tuyệt đối theo chính sách riêng tư.
                        </div>
                    }
                </div>

                <div class="d-flex gap-2 mt-4">
                    @if (canViewCccd)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.MaKh" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Chỉnh sửa</a>
                    }
                    <a asp-action="Index" class="btn btn-light">Danh sách khách hàng</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột danh sách hợp đồng của khách hàng -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-file-earmark-text text-primary me-2"></i>Lịch sử Hợp đồng cầm đồ</h5>
                    @if (canViewCccd)
                    {
                        <a asp-controller="HopDongCam" asp-action="Create" class="btn btn-sm btn-primary">
                            <i class="bi bi-plus-lg me-1"></i>Lập hợp đồng mới
                        </a>
                    }
                </div>
                <hr />

                @if (!Model.HopDongCams.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-folder2-open fs-1 d-block mb-2"></i>
                        Khách hàng chưa có hợp đồng cầm đồ nào.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã HĐ</th>
                                    <th>Tài sản</th>
                                    <th>Tiền cầm</th>
                                    <th>Hạn chuộc</th>
                                    <th>Trạng thái</th>
                                    <th class="text-end">Xem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var hd in Model.HopDongCams.OrderByDescending(h => h.MaHd))
                                {
                                    <tr>
                                        <td class="fw-bold">HD-@hd.MaHd</td>
                                        <td>
                                            @if (hd.TaiSans.Any())
                                            {
                                                <span>@hd.TaiSans.First().TenTaiSan</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Chưa gắn tài sản</span>
                                            }
                                        </td>
                                        <td class="text-primary fw-bold">@hd.TienCam.ToString("N0") đ</td>
                                        <td>@hd.HanChuoc.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (hd.TrangThai == "đang cầm")
                                            {
                                                <span class="badge badge-status-dangcam">Đang cầm</span>
                                            }
                                            else if (hd.TrangThai == "quá hạn")
                                            {
                                                <span class="badge badge-status-quahan">Quá hạn</span>
                                            }
                                            else if (hd.TrangThai == "thanh lý")
                                            {
                                                <span class="badge badge-status-thanhly">Thanh lý</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-status-dachuoc">Đã chuộc</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="HopDongCam" asp-action="Details" asp-route-id="@hd.MaHd" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
