@model IEnumerable<QLCamDo_Nhom4_LopK24CNT2.Models.KhachHang>

@{
    ViewData["Title"] = "Quản lý khách hàng";
    Layout = "_Layout";
    var search = ViewBag.CurrentSearch as string;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalItems = ViewBag.TotalItems;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Quản lý Khách Hàng</h3>
        <p class="text-muted small mb-0">Hồ sơ khách hàng, số CCCD (12 số) và danh sách hợp đồng cầm cố liên quan</p>
    </div>
    @if (!User.IsInRole("Khách hàng"))
    {
        <a asp-action="Create" class="btn btn-primary rounded-3 shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i>Thêm khách hàng mới
        </a>
    }
</div>

<!-- Khung tìm kiếm và lọc -->
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Tìm theo Họ tên, Số CCCD, Số điện thoại..." value="@search" />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Tìm kiếm</button>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Mã KH</th>
                    <th>Họ và tên</th>
                    <th>Số CCCD (12 số)</th>
                    <th>Số điện thoại</th>
                    <th>Địa chỉ</th>
                    <th>Số hợp đồng</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Không tìm thấy khách hàng nào phù hợp!
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-secondary">KH-@item.MaKh</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(item.AnhCccd) && (User.IsInRole("Chủ cửa hàng") || User.IsInRole("Nhân viên")))
                                    {
                                        <a href="@item.AnhCccd" target="_blank" title="Xem ảnh CCCD gốc">
                                            <img src="@item.AnhCccd" class="asset-thumbnail-sm shadow-sm border" alt="CCCD" />
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="p-2 bg-light rounded-circle text-primary">
                                            <i class="bi bi-person-fill fs-5"></i>
                                        </div>
                                    }
                                    <div>
                                        <div class="fw-bold text-dark">@item.HoTen</div>
                                        @if (!string.IsNullOrEmpty(item.AnhCccd) && (User.IsInRole("Chủ cửa hàng") || User.IsInRole("Nhân viên")))
                                        {
                                            <small class="text-success fw-semibold"><i class="bi bi-shield-check me-1"></i>Đã có CCCD</small>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark font-monospace border px-2 py-1">@item.SoCccd</span>
                            </td>
                            <td>
                                <span class="text-muted"><i class="bi bi-telephone me-1"></i>@item.SoDienThoai</span>
                            </td>
                            <td>
                                <span class="text-truncate d-inline-block" style="max-width: 200px;">@(item.DiaChi ?? "Chưa cập nhật")</span>
                            </td>
                            <td>
                                <span class="badge bg-primary bg-opacity-10 text-primary">@item.HopDongCams.Count hợp đồng</span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.MaKh" class="btn btn-outline-info" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (!User.IsInRole("Khách hàng"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.MaKh" class="btn btn-outline-warning" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (User.IsInRole("Chủ cửa hàng"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@item.MaKh" class="btn btn-outline-danger" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <small class="text-muted">Tổng cộng <strong>@totalItems</strong> khách hàng (Trang @currentPage/@totalPages)</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@search">Trước</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(currentPage == p ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@search">@p</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@search">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
