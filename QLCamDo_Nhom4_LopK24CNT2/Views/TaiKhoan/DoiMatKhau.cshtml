@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3"><i class="bi bi-key text-primary me-2"></i>Đổi mật khẩu</h4>
                <form asp-action="DoiMatKhau" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật khẩu hiện tại</label>
                        <input name="matKhauCu" type="password" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật khẩu mới</label>
                        <input name="matKhauMoi" type="password" class="form-control" required placeholder="Tối thiểu 6 ký tự" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
                        <input name="xacNhanMatKhau" type="password" class="form-control" required />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Cập nhật mật khẩu</button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-light px-4">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
