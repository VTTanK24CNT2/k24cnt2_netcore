@model IEnumerable<QLCamDo_Nhom4_LopK24CNT2.Models.TaiKhoan>

@{
    ViewData["Title"] = "Quản lý tài khoản nhân viên";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>Quản lý tài khoản người dùng</h3>
        <p class="text-muted small mb-0">Danh sách tài khoản quản trị, nhân viên và khách hàng trong hệ thống</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-3">
        <i class="bi bi-plus-lg me-1"></i>Thêm tài khoản nhân viên
    </a>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Mã TK</th>
                    <th>Tên đăng nhập</th>
                    <th>Vai trò</th>
                    <th>Khách hàng liên kết</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-semibold">TK-@item.MaTk</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="p-2 bg-light rounded-circle text-primary"><i class="bi bi-person"></i></span>
                                <span class="fw-bold">@item.TenDangNhap</span>
                            </div>
                        </td>
                        <td>
                            @if (item.VaiTro == "Chủ cửa hàng")
                            {
                                <span class="badge bg-danger">Chủ cửa hàng (Admin)</span>
                            }
                            else if (item.VaiTro == "Nhân viên")
                            {
                                <span class="badge bg-primary">Nhân viên</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Khách hàng</span>
                            }
                        </td>
                        <td>
                            @if (item.MaKhNavigation != null)
                            {
                                <a asp-controller="KhachHang" asp-action="Details" asp-route-id="@item.MaKh" class="text-decoration-none">
                                    @item.MaKhNavigation.HoTen (CCCD: @item.MaKhNavigation.SoCccd)
                                </a>
                            }
                            else
                            {
                                <span class="text-muted italic">-- Nội bộ --</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đang hoạt động</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
