<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Cầm Đồ C</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary-color: #0d6efd;
            --primary-dark: #0a58ca;
            --success-color: #198754;
            --warning-color: #fd7e14;
            --danger-color: #dc3545;
            --dark-color: #1e293b;
            --body-bg: #f8fafc;
            --card-border: #e2e8f0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--body-bg);
            color: #334155;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-custom {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 0.75rem 1rem;
        }

        .navbar-custom .navbar-brand {
            font-weight: 700;
            font-size: 1.25rem;
            color: #ffffff !important;
            letter-spacing: -0.5px;
        }

        .navbar-custom .nav-link {
            color: #94a3b8 !important;
            font-weight: 500;
            padding: 0.5rem 0.85rem !important;
            border-radius: 6px;
            transition: all 0.2s ease;
        }

        .navbar-custom .nav-link:hover, .navbar-custom .nav-link.active {
            color: #ffffff !important;
            background-color: rgba(255, 255, 255, 0.1);
        }

        .card {
            border: 1px solid var(--card-border);
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03);
            background: #ffffff;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .badge-status-dangcam { background-color: #e0f2fe; color: #0284c7; font-weight: 600; }
        .badge-status-quahan { background-color: #fee2e2; color: #dc2626; font-weight: 600; }
        .badge-status-thanhly { background-color: #f3e8ff; color: #9333ea; font-weight: 600; }
        .badge-status-dachuoc { background-color: #dcfce7; color: #16a34a; font-weight: 600; }
        .badge-status-sapdenhan { background-color: #ffedd5; color: #ea580c; font-weight: 600; }

        .btn-primary {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            border: none;
            font-weight: 500;
            box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25);
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
        }

        .table th {
            font-weight: 600;
            color: #475569;
            background-color: #f8fafc;
            border-top: none;
            white-space: nowrap;
        }

        footer {
            margin-top: auto;
            background: #ffffff;
            border-top: 1px solid var(--card-border);
            padding: 1.25rem 0;
            color: #64748b;
        }

        @@media print {
            .no-print, header, footer, .btn, .breadcrumb {
                display: none !important;
            }
            body {
                background: white !important;
            }
            .card {
                border: none !important;
                box-shadow: none !important;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="no-print">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="p-2 bg-primary rounded-3 text-white d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-gem"></i>
                    </span>
                    <span>CẦM ĐỒ C</span>
                    <small class="badge bg-secondary ms-1 fw-normal text-white-50" style="font-size: 0.65rem;">K24-N4</small>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Tổng quan
                                </a>
                            </li>

                            @if (User.IsInRole("Chủ cửa hàng") || User.IsInRole("Nhân viên"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="HopDongCam" asp-action="Index">
                                        <i class="bi bi-file-earmark-text me-1"></i>Hợp đồng cầm
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="KhachHang" asp-action="Index">
                                        <i class="bi bi-people me-1"></i>Khách hàng
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="TaiSan" asp-action="Index">
                                        <i class="bi bi-box-seam me-1"></i>Tài sản
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="GiaoDich" asp-action="Index">
                                        <i class="bi bi-cash-stack me-1"></i>Giao dịch & Thu lãi
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Chủ cửa hàng"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-gear me-1"></i>Quản trị
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark">
                                        <li><a class="dropdown-item" asp-controller="LoaiTaiSan" asp-action="Index"><i class="bi bi-tags me-2"></i>Loại tài sản & Lãi suất</a></li>
                                        <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="Index"><i class="bi bi-person-badge me-2"></i>Tài khoản nhân viên</a></li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Khách hàng"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="HopDongCam" asp-action="Index">
                                        <i class="bi bi-file-earmark-check me-1"></i>Hợp đồng của tôi
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="GiaoDich" asp-action="Index">
                                        <i class="bi bi-clock-history me-1"></i>Lịch sử đóng lãi
                                    </a>
                                </li>
                            }
                        }

                        <li class="nav-item">
                            <a class="nav-link text-warning fw-semibold" asp-controller="TaiSan" asp-action="ThanhLy">
                                <i class="bi bi-tag me-1"></i>Tài sản thanh lý
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-light dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i>
                                    <span>@User.Identity.Name</span>
                                    <span class="badge bg-primary">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User")</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="DoiMatKhau"><i class="bi bi-key me-2"></i>Đổi mật khẩu</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="TaiKhoan" asp-action="DangXuat"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-light" asp-controller="TaiKhoan" asp-action="DangNhap">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                            </a>
                            <a class="btn btn-sm btn-primary" asp-controller="TaiKhoan" asp-action="DangKy">
                                <i class="bi bi-person-plus me-1"></i>Đăng ký
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid py-4 flex-grow-1">
        <div class="container">
            <!-- Thông báo thành công / lỗi -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 no-print shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 no-print shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show d-flex align-items-center gap-2 no-print shadow-sm" role="alert">
                    <i class="bi bi-info-circle-fill fs-5"></i>
                    <div>@TempData["InfoMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="no-print">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <div>
                &copy; 2026 - <strong>Hệ Thống Quản Lý Cầm Đồ C</strong> - Nhóm 4 Lớp K24CNT2
            </div>
            <div class="d-flex gap-3">
                <span class="text-muted"><i class="bi bi-shield-check me-1"></i>Bảo mật cao</span>
                <span class="text-muted"><i class="bi bi-lightning-charge me-1"></i>Tự động tính lãi</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
