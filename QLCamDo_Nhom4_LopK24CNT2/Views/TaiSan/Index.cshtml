@model IEnumerable<QLCamDo_Nhom4_LopK24CNT2.Models.TaiSan>

@{
    ViewData["Title"] = "Quản lý tài sản";
    Layout = "_Layout";

    var search = ViewBag.CurrentSearch as string;
    int? maLoai = ViewBag.CurrentMaLoai as int?;
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalItems = ViewBag.TotalItems;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-box-seam-fill text-primary me-2"></i>Quản lý Tài Sản Cầm Cố</h3>
        <p class="text-muted small mb-0">Theo dõi thông tin kiểm định, hình ảnh thực tế và định giá tài sản của khách hàng</p>
    </div>
    <a asp-action="ThanhLy" class="btn btn-warning rounded-3 shadow-sm text-dark fw-semibold">
        <i class="bi bi-tag-fill me-1"></i>Xem tài sản thanh lý
    </a>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Tìm tên tài sản, khách hàng..." value="@search" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="maLoai" class="form-select" asp-items="ViewBag.LoaiTaiSans">
                    <option value="">-- Tất cả nhóm loại tài sản --</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Tìm</button>
                @if (!string.IsNullOrEmpty(search) || maLoai.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Hình ảnh</th>
                    <th>Tên tài sản</th>
                    <th>Loại</th>
                    <th>Hợp đồng & Khách</th>
                    <th>Giá trị định giá</th>
                    <th>Trạng thái HĐ</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Không tìm thấy tài sản nào!</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var firstImg = item.AnhTaiSan?.Split(';', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
                        <tr>
                            <td class="ps-4" style="width: 90px;">
                                @if (!string.IsNullOrEmpty(firstImg))
                                {
                                    <a href="@firstImg" target="_blank" title="Xem ảnh gốc">
                                        <img src="@firstImg" class="asset-thumbnail-sm shadow-sm" style="width: 76px; height: 54px;" alt="@item.TenTaiSan" />
                                    </a>
                                }
                                else
                                {
                                    <div class="rounded bg-light d-flex align-items-center justify-content-center text-muted border" style="width: 70px; height: 50px;">
                                        <i class="bi bi-image fs-4"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.TenTaiSan</div>
                                <small class="text-muted">Mã: TS-@item.MaTs</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.MaLoaiNavigation?.TenLoai</span>
                            </td>
                            <td>
                                <div><a asp-controller="HopDongCam" asp-action="Details" asp-route-id="@item.MaHd" class="fw-semibold text-decoration-none">HD-@item.MaHd</a></div>
                                <small class="text-muted">@item.MaHdNavigation?.MaKhNavigation?.HoTen</small>
                            </td>
                            <td>
                                <span class="fw-bold text-primary">@((item.GiaTriDinhGia ?? 0).ToString("N0")) đ</span>
                            </td>
                            <td>
                                @if (item.MaHdNavigation?.TrangThai == "đang cầm")
                                {
                                    <span class="badge badge-status-dangcam">Đang cầm</span>
                                }
                                else if (item.MaHdNavigation?.TrangThai == "quá hạn")
                                {
                                    <span class="badge badge-status-quahan">Quá hạn</span>
                                }
                                else if (item.MaHdNavigation?.TrangThai == "thanh lý")
                                {
                                    <span class="badge badge-status-thanhly">Thanh lý</span>
                                }
                                else
                                {
                                    <span class="badge badge-status-dachuoc">Đã chuộc</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.MaTs" class="btn btn-outline-info" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (!User.IsInRole("Khách hàng"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.MaTs" class="btn btn-outline-warning" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
            <small class="text-muted">Tổng cộng <strong>@totalItems</strong> tài sản (Trang @currentPage/@totalPages)</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@search" asp-route-maLoai="@maLoai">Trước</a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(currentPage == p ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@search" asp-route-maLoai="@maLoai">@p</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@search" asp-route-maLoai="@maLoai">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
