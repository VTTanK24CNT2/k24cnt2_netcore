@model IEnumerable<QLCamDo_Nhom4_LopK24CNT2.Models.TaiSan>

@{
    ViewData["Title"] = "Kho tài sản thanh lý - Giá tốt";
    Layout = "_Layout";
    var search = ViewBag.CurrentSearch as string;
}

<!-- Hero Banner Kho Thanh Lý -->
<div class="mb-4">
    <div class="p-4 p-md-5 rounded-4 text-white position-relative overflow-hidden shadow-sm" 
         style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);">
        <div class="row align-items-center position-relative" style="z-index: 2;">
            <div class="col-lg-8">
                <span class="badge bg-warning text-dark px-3 py-2 fw-bold mb-3 shadow-sm">
                    <i class="bi bi-tag-fill me-1"></i>SẢN PHẨM THANH LÝ QUÁ HẠN CHUỘC
                </span>
                <h2 class="fw-bold display-6 mb-2">Showroom Tài Sản Thanh Lý Cầm Đồ C</h2>
                <p class="text-light text-opacity-75 mb-0 fs-6">
                    Tất cả tài sản đã được kiểm định chất lượng, nguồn gốc rõ ràng, máy móc nguyên zin và được mở bán thanh lý thu hồi vốn với mức giá ưu đãi nhất thị trường.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <div class="d-inline-flex flex-column align-items-lg-end gap-1">
                    <span class="badge bg-danger fs-5 px-3 py-2 shadow-sm">
                        <i class="bi bi-fire me-1"></i>Đang mở bán: @Model.Count() sản phẩm
                    </span>
                    <small class="text-white-50">Cập nhật theo thời gian thực</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Thanh tìm kiếm & lọc nhóm hàng -->
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-3">
        <form asp-action="ThanhLy" method="get" class="row g-2 align-items-center">
            <div class="col-md-7">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Tìm theo tên xe máy, laptop, điện thoại, vàng..." value="@search" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="maLoai" class="form-select" asp-items="ViewBag.LoaiTaiSans">
                    <option value="">-- Tất cả nhóm hàng --</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-warning text-dark fw-bold w-100 shadow-sm">
                    <i class="bi bi-funnel me-1"></i>Lọc sản phẩm
                </button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm border-0 rounded-4 p-5 text-center">
        <i class="bi bi-bag-x fs-1 text-muted mb-3"></i>
        <h5 class="fw-bold text-dark">Hiện chưa có tài sản thanh lý nào phù hợp</h5>
        <p class="text-muted">Các tài sản quá hạn sẽ được Chủ cửa hàng duyệt và hiển thị tự động tại đây.</p>
    </div>
}
else
{
    <!-- Lưới hiển thị sản phẩm với hình ảnh thật lớn, sắc nét -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
        @foreach (var item in Model)
        {
            var images = item.AnhTaiSan?.Split(';', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
            var firstImg = images.FirstOrDefault() ?? "/uploads/taisan/XeMay.jpg";
            var giaThanhLy = item.GiaTriDinhGia ?? 0;

            <div class="col">
                <div class="product-card h-100 d-flex flex-column shadow-sm">
                    <!-- Ảnh sản phẩm lớn kèm hover zoom -->
                    <div class="product-img-wrap">
                        <img src="@firstImg" alt="@item.TenTaiSan" loading="lazy" />
                        <span class="position-absolute top-0 end-0 m-3 badge bg-danger fs-6 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i>THANH LÝ
                        </span>
                        <span class="position-absolute bottom-0 start-0 m-3 badge bg-dark bg-opacity-75 text-white">
                            <i class="bi bi-tag me-1"></i>@item.MaLoaiNavigation?.TenLoai
                        </span>
                    </div>

                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <h5 class="fw-bold text-dark mb-2">@item.TenTaiSan</h5>

                        <div class="text-muted small mb-3 flex-grow-1">
                            @if (!string.IsNullOrEmpty(item.MoTaTinhTrang))
                            {
                                <div>@Html.Raw(item.MoTaTinhTrang)</div>
                            }
                            else
                            {
                                <span>Tài sản nguyên bản, đã được chuyên viên kiểm tra hoạt động ổn định.</span>
                            }
                        </div>

                        <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">GIÁ THANH LÝ:</small>
                                <span class="price-tag">@giaThanhLy.ToString("N0") VNĐ</span>
                            </div>
                            <button type="button" class="btn btn-primary rounded-3 px-3 fw-semibold btn-dang-ky shadow-sm"
                                    data-id="@item.MaTs"
                                    data-name="@item.TenTaiSan"
                                    data-img="@firstImg"
                                    data-price="@giaThanhLy"
                                    data-bs-toggle="modal"
                                    data-bs-target="#dangKyModal">
                                <i class="bi bi-cart-check me-1"></i>Đăng ký mua
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Modal Đăng Ký Mua Tài Sản Thanh Lý (Có preview ảnh lớn) -->
<div class="modal fade" id="dangKyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-bag-check-fill text-success me-2"></i>Đăng ký mua tài sản thanh lý</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="DangKyMua" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" name="MaTs" id="modalMaTs" />

                    <!-- Ảnh và tên sản phẩm trong modal -->
                    <div class="card border-0 bg-light p-3 rounded-3 mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <img id="modalImg" src="" class="rounded-3 border shadow-sm" style="width: 80px; height: 60px; object-fit: cover;" alt="Preview" />
                            <div>
                                <h6 id="modalTenTaiSan" class="fw-bold text-dark mb-1"></h6>
                                <div class="small text-muted">Giá niêm yết: <span id="modalGia" class="fw-bold text-danger"></span></div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Họ và tên người mua</label>
                        <input name="HoTen" class="form-control" required placeholder="Nguyễn Văn A" value="@User.Identity?.Name" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Số điện thoại liên hệ</label>
                        <input name="SoDienThoai" class="form-control" required placeholder="09xxxxxxxx" maxlength="10" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Giá bạn đề xuất mua (VNĐ)</label>
                        <input name="GiaDeXuat" type="number" class="form-control" placeholder="Để trống nếu mua đúng giá niêm yết" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold small">Lời nhắn cho cửa hàng</label>
                        <textarea name="GhiChu" rows="2" class="form-control" placeholder="Ví dụ: Tôi muốn đến xem xe vào chiều nay..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success px-4 fw-semibold"><i class="bi bi-check2-circle me-1"></i>Xác nhận đăng ký mua</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('.btn-dang-ky').on('click', function () {
            const id = $(this).data('id');
            const name = $(this).data('name');
            const img = $(this).data('img');
            const price = parseFloat($(this).data('price')) || 0;

            $('#modalMaTs').val(id);
            $('#modalTenTaiSan').text(name);
            $('#modalImg').attr('src', img);
            $('#modalGia').text(price.toLocaleString('vi-VN') + ' VNĐ');
        });
    </script>
}
